#!/usr/bin/env python3
"""
table-ronde-fast — Moteur délibératif local ultra-rapide 0-token.
Interroge 3 experts spécialisés + 1 arbitre de synthèse.
Inférence GPU M1 (10.42.0.230:1234 - qwen2.5-coder-14b-instruct) -> Ollama -> Déterministe.
"""

import sys
import os
import json
import sqlite3
import urllib.request
import urllib.error
from concurrent.futures import ThreadPoolExecutor

BIBLIO_DBS = [
    "/home/pamerys/jarvis/databases/bibliotheque.db",
    os.path.expanduser("~/.claude/bibliotheque/bibliotheque.db")
]
M1_LMS_URL = os.environ.get("M1_LMS_URL", "http://10.42.0.230:1234/v1/chat/completions")
OLLAMA_URL = "http://127.0.0.1:11434/api/generate"
MODEL_M1 = "qwen2.5-coder-14b-instruct"

EXPERTS = [
    {"id": "archi", "name": "🏛️ L'Architecte Souverain", "role": "Pérennité, simplicité, modularité, zéro goulot d'étranglement et streaming direct."},
    {"id": "finops", "name": "⚡ L'Arbitre FinOps 0-Token", "role": "Coût nul, calcul déterministe, efficience GPU M1 et zéro allocation stérile."},
    {"id": "sec", "name": "🛡️ L'Expert Sécurité & CLAIRE", "role": "Résilience aux pannes, zero-trust, conformité EU AI Act et traçabilité absolue."}
]

def search_context(query, limit=3):
    contexts = []
    for db_path in BIBLIO_DBS:
        if os.path.exists(db_path):
            try:
                with sqlite3.connect(db_path) as c:
                    terms = ' OR '.join([w for w in query.split() if len(w) > 2][:3])
                    if terms:
                        tables = [t[0] for t in c.execute("SELECT name FROM sqlite_master WHERE type='table'").fetchall()]
                        if 'blocs' in tables:
                            rows = c.execute("SELECT bloc_id, mots_cles, action FROM blocs WHERE blocs MATCH ? LIMIT ?", (terms, limit)).fetchall()
                            for r in rows:
                                contexts.append(f"[{r[0]}] {r[1]} -> {r[2]}")
                        elif 'elements' in tables:
                            rows = c.execute("SELECT titre, contenu FROM elements LIMIT ?", (limit,)).fetchall()
                            for r in rows:
                                contexts.append(f"[{r[0]}] {r[1][:150]}")
            except Exception:
                pass
    return "\n".join(contexts) if contexts else "Contexte souverain SWAN / CLAIRE actif."

def query_llm(prompt, system_prompt, max_tokens=150, timeout=6):
    # 1. LMStudio M1 (Lien direct USB-C ASIX 10.42.0.230 - 1.4 ms)
    try:
        payload = {
            "model": MODEL_M1,
            "messages": [
                {"role": "system", "content": system_prompt},
                {"role": "user", "content": prompt}
            ],
            "temperature": 0.2,
            "max_tokens": max_tokens
        }
        req = urllib.request.Request(M1_LMS_URL, data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode())
            return data["choices"][0]["message"]["content"].strip()
    except Exception:
        pass

    # 2. Ollama Local (127.0.0.1)
    try:
        payload = {
            "model": "gemma3:4b",
            "prompt": f"System: {system_prompt}\n\nContexte:\n{prompt}",
            "stream": False,
            "options": {"num_predict": max_tokens, "temperature": 0.3}
        }
        req = urllib.request.Request(OLLAMA_URL, data=json.dumps(payload).encode(), headers={"Content-Type": "application/json"})
        with urllib.request.urlopen(req, timeout=timeout) as resp:
            data = json.loads(resp.read().decode())
            return data.get("response", "").strip()
    except Exception:
        pass

    # 3. Fallback Déterministe
    return "Appliquer la doctrine SWAN / LUMIÈRE 2 : zéro rétention stérile, distribution en streaming direct et traçabilité CLAIRE."

def main():
    if len(sys.argv) < 2:
        print("Usage: table-ronde \"<votre question ou arbitrage>\"")
        sys.exit(1)
        
    query = " ".join(sys.argv[1:])
    print(f"\n{'='*75}")
    print(f"🏛️  TABLE RONDE JARVIS 0-TOKEN — DÉBAT MULTI-EXPERTS (LUMIÈRE 2 / SWAN)")
    print(f"📌 Sujet : {query}")
    print(f"{'='*75}\n")
    
    ctx = search_context(query)
    
    def consult(expert):
        sys_p = f"Tu es {expert['name']} ({expert['role']}). Donne 2 points précis et actionnables en français (35 mots max)."
        user_p = f"Question : {query}\n\nContexte :\n{ctx}"
        ans = query_llm(user_p, sys_p, max_tokens=90, timeout=6)
        return expert, ans

    with ThreadPoolExecutor(max_workers=3) as executor:
        results = list(executor.map(consult, EXPERTS))

    expert_summaries = []
    for exp, ans in results:
        print(f"{exp['name']} :")
        print(f"  {ans}\n")
        expert_summaries.append(f"{exp['name']}: {ans}")

    # Arbitre
    print("⚖️  L'Arbitre de Table (Décision Finale) :")
    arb_sys = "Tu es l'Arbitre Suprême. Rends la décision finale tranchée en 2 phrases concrètes en français."
    arb_user = f"Sujet: {query}\n\nAvis des 3 experts:\n" + "\n".join(expert_summaries)
    verdict = query_llm(arb_user, arb_sys, max_tokens=70, timeout=6)
    print(f"  👉 {verdict}\n")
    print(f"{'='*75}\n")

if __name__ == "__main__":
    main()
