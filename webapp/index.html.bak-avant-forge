const DAYS = ['Lundi','Mardi','Mercredi','Jeudi','Vendredi'];
const HOURS = ['08:00','09:00','10:00','11:00','12:00','13:00','14:00','15:00','16:00','17:00'];
const TODAY_IDX = new Date().getDay(); // 1=Lundi…5=Vendredi

function renderPlanningGrid(gridId, cours, accent) {
  const grid = document.getElementById(gridId);
  if (!grid) return;
  grid.innerHTML = '<div class="pg-header"></div>';
  DAYS.forEach((d, i) => {
    const isToday = (i + 1) === TODAY_IDX;
    grid.innerHTML += `<div class="pg-header${isToday ? ' today' : ''}">${d}</div>`;
  });
  HOURS.forEach(h => {
    grid.innerHTML += `<div class="pg-hour">${h}</div>`;
    DAYS.forEach((d, i) => {
      const isToday = (i + 1) === TODAY_IDX;
      const matching = cours.filter(c => c.jour === d && c.heure === h);
      const inner = matching.map(c =>
        `<div class="pg-cours${isToday ? ' current-day' : ''}" style="border-left:3px solid ${accent}"
              title="Supprimer" onclick="delCours(${c.id})">
          <b>${escHtml(c.titre)}</b>${c.salle ? '<br>' + escHtml(c.salle) : ''}
        </div>`
      ).join('');
      grid.innerHTML += `<div class="pg-cell">${inner}</div>`;
    });
  });
}

