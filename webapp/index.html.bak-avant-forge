let PROF_ELEVES = [];
const $ = id => document.getElementById(id);
const NIVEAUX = ['TPS','PS','MS','GS','CP','CE1','CE2','CM1','CM2'];
function esc(s){return (s||'').replace(/[&<>"]/g,c=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;'}[c]));}
function md(s){ // mini-markdown → HTML (sûr : on échappe d'abord)
  let h = esc(s);
  h = h.replace(/^### (.*)$/gm,'<h4>$1</h4>').replace(/^## (.*)$/gm,'<h3>$1</h3>').replace(/^# (.*)$/gm,'<h3>$1</h3>');
  h = h.replace(/\*\*(.+?)\*\*/g,'<b>$1</b>');
  return '<div style="white-space:pre-wrap;line-height:1.5">'+h+'</div>';
}
