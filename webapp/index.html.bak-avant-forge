function tempColor(t) {
  if (t >= 95) return 'c-red';
  if (t >= 80) return 'c-orange';
  return 'c-green';
}

async function refreshStatus() {
  try {
    const d = await fetch('/api/status').then(r => r.json());
    const gpu = d.gpu || {};
    const temp = gpu.temp || 0;
    const cls  = tempColor(temp);
    ['d-gpu-temp','s-gpu'].forEach(id => {
      const el = document.getElementById(id);
      if (el) { el.textContent = temp + '°C'; el.className = 'value ' + cls; }
    });
    ['d-state','s-state'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = gpu.state || '—';
    });
    ['d-fan','s-fan'].forEach(id => {
      const el = document.getElementById(id);
      if (el) el.textContent = (gpu.fan_rpm || 0) + ' RPM';
    });
    const oc = document.getElementById('s-oc');
    if (oc) {
      oc.textContent = d.oc_active ? 'OUI' : 'NON';
      oc.className = 'value ' + (d.oc_active ? 'c-green' : 'c-orange');
    }
  } catch(e) { /* silent */ }
}

