async function loadLogiciels() {
  const grid = document.getElementById('logiciels-grid');
  grid.innerHTML = '<div class="sub">Chargement…</div>';
  try {
    const apps = await (await fetch('/api/logiciels')).json();
    grid.innerHTML = apps.map(a => {
      const st = LOG_STATUTS[a.statut] || {txt:a.statut, c:'var(--muted)'};
      const canLaunch = a.statut === 'pret';
      const canInstall = a.statut === 'installable' && a.wine_ready;
      let btns = '';
      if (canLaunch) btns += `<button class="btn" onclick="launchApp('${a.id}')">▶ Lancer</button>`;
      if (canInstall) btns += `<button class="btn" onclick="installApp('${a.id}')">⬇ Installer</button>`;
      if (a.url) btns += `<button class="btn secondary" onclick="window.open('${a.url}','_blank')">🌐 Site</button>`;
      if (!a.wine_ready && a.type==='wine') btns += `<span class="sub" style="color:var(--orange)">Wine en cours d'installation…</span>`;
      return `<div class="card" style="text-align:left">
        <div style="font-size:28px">${a.icon||'📦'}</div>
        <div class="value" style="font-size:16px">${a.nom}</div>
        <div class="sub">${a.categorie||''} · <b style="color:${st.c}">${st.txt}</b></div>
        <div class="sub" style="margin:8px 0;font-size:11px">${a.note||''}</div>
        <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:8px">${btns}</div>
      </div>`;
    }).join('');
  } catch (e) {
    grid.innerHTML = '<div class="sub" style="color:var(--red)">Erreur: '+e+'</div>';
  }
}
