    const d=await fetch('/api/adaptatif/journal').then(r=>r.json());
    const j=d.journal||[];
    if(!j.length){ el.innerHTML='<em>Aucune observation cette semaine. Ajoute ce que tu remarques ↑</em>'; return; }
    const ICO={eleve:'👧',probleme:'⚠️',sortie:'🚌',actualite:'📰',demande:'🙋',recherche:'🔎',note:'📝'};
    el.innerHTML=j.map(o=>`<div style="display:flex;gap:8px;align-items:center;padding:3px 0">
      <span>${ICO[o.categorie]||'📝'}</span><span style="flex:1">${escHtml(o.texte)}</span>
      <button class="btn secondary" style="padding:2px 8px" onclick="delAdaptNote(${o.id})">✕</button></div>`).join('');
  }catch(e){ el.textContent='⚠ chargement journal impossible'; }
}
async function addAdaptNote(){
  const txt=document.getElementById('adapt-txt'), cat=document.getElementById('adapt-cat');
  if(!txt.value.trim()) return;
  await fetch('/api/adaptatif/note',{method:'POST',headers:{'Content-Type':'application/json'},
    body:JSON.stringify({categorie:cat.value,texte:txt.value.trim()})}).catch(()=>{});
  txt.value=''; loadAdaptJournal();
}
async function delAdaptNote(id){
  await fetch('/api/adaptatif/note/'+id,{method:'DELETE'}).catch(()=>{});
  loadAdaptJournal();
}
async function actualiserSemaine(){
  const btn=document.getElementById('adapt-go'), st=document.getElementById('adapt-status'), res=document.getElementById('adapt-result');
  btn.disabled=true; st.textContent='génération en cours (IA locale)…'; res.textContent='';
  try{
    const d=await fetch('/api/adaptatif/actualiser',{method:'POST'}).then(r=>r.json());
    if(d.ok){ st.textContent='✅ '+d.backend+' · '+d.base.observations+' obs · '+d.base.eleves+' élèves';
      res.textContent=d.propositions; }
    else { st.textContent='⚠ '+(d.error||'échec'); }
  }catch(e){ st.textContent='⚠ réseau'; }
  btn.disabled=false;
}
// Dashboard Admin : état consolidé (backends IA, bases, sauvegardes, thermique)
async function loadAdmin(){
  const el=document.getElementById('admin-etat'); if(!el) return;
  try{
    const d=await fetch('/api/admin/etat').then(r=>r.json());
    const cpu=document.getElementById('admin-cpu');
    if(cpu) cpu.textContent = d.cpu_temp!=null ? ('CPU '+d.cpu_temp+'°C'+(d.cpu_temp>=82?' 🔥':'')) : '';
    const be=(d.backends||[]).map(b=>`<span class="pill">${b.up?'🟢':'⚫'} ${escHtml(b.nom)}${b.modele?' · '+escHtml(String(b.modele)):''}</span>`).join(' ');
    const ba=(d.bases||[]).map(b=>`<span class="pill">${b.present?'🗄️':'❌'} ${escHtml(b.nom)}${b.tables!=null?' ('+b.tables+' tables, '+b.ko+' Ko)':''}</span>`).join(' ');
    const sv=d.sauvegardes||{};
    el.innerHTML=`<div style="margin-bottom:8px"><strong>IA :</strong> ${be||'—'}</div>
      <div style="margin-bottom:8px"><strong>Bases :</strong> ${ba||'—'}</div>
      <div><strong>Sauvegardes :</strong> ${sv.total||0} · dernière : ${sv.derniere?escHtml(sv.derniere):'aucune'}</div>`;
  }catch(e){ el.textContent='⚠ impossible de charger l\'état'; }
}
async function backupNow(){
  const el=document.getElementById('admin-etat');
  try{ const r=await fetch('/api/backup',{method:'POST'}).then(r=>r.json());
    if(r.ok){ loadAdmin(); } else { if(el) el.textContent='⚠ '+(r.error||'échec sauvegarde'); }
  }catch(e){ if(el) el.textContent='⚠ réseau'; }
}
// Installation de l'app : capte l'invite navigateur et affiche un bouton "Installer"
let _deferredInstall=null;
window.addEventListener('beforeinstallprompt',e=>{
  e.preventDefault(); _deferredInstall=e;
  const b=document.getElementById('btn-install-app'); if(b) b.style.display='flex';
});
async function installerApp(){
  if(!_deferredInstall){ alert("Pour installer : menu du navigateur → « Installer Pousseline » / « Ajouter à l'écran d'accueil »."); return; }
  _deferredInstall.prompt();
  const {outcome}=await _deferredInstall.userChoice;
  if(outcome==='accepted'){ const b=document.getElementById('btn-install-app'); if(b) b.style.display='none'; }
  _deferredInstall=null;
}
window.addEventListener('appinstalled',()=>{const b=document.getElementById('btn-install-app'); if(b) b.style.display='none';});
</script>
