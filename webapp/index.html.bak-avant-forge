<script>
/* ════════════════════════════════════════════════════════════════════════
   NAVIGATION
════════════════════════════════════════════════════════════════════════ */
const SECTIONS = ['dashboard','planning','edt','groupes','import','appel','ateliers','budget','notes','carnet','prof','biblio','sorties','equipe','automations','logiciels','assistant','documents','systeme','calendrier','agents','todo','outils','commandes','planb','supports'];

function navigate(id) {
  SECTIONS.forEach(s => {
    document.getElementById('section-' + s).classList.toggle('active', s === id);
  });
  document.querySelectorAll('nav a').forEach(a => {
    a.classList.toggle('active', a.dataset.section === id);
  });
  if (id === 'planning')  loadPlanning();
  if (id === 'edt')       loadEdt();
  if (id === 'groupes')   loadGroupes();
  if (id === 'import')    loadImport();
  if (id === 'appel')     loadAppel();
  if (id === 'ateliers')  loadAteliers();
  if (id === 'budget')    loadBudget();
  if (id === 'notes')     loadNotes();
  if (id === 'carnet')    loadCarnet();
  if (id === 'documents') loadDocs();
  if (id === 'systeme')   { loadServices(); loadAdmin(); loadIntegrations(); }
  if (id === 'logiciels') loadLogiciels();
  if (id === 'prof')      loadProf();
  if (id === 'biblio')    loadBiblio();
  if (id === 'sorties')   loadSorties();
  if (id === 'equipe')  { loadCollegues(); loadReunions(); }
  if (id === 'automations') { loadAutoSuggestions(); loadAdaptJournal(); }
  if (id === 'outils')    loadOutils();
  if (id === 'commandes') loadCommandes();
  if (id === 'planb')     loadPlanB();
}

/* ── OUTILS CLASSE ── */
let OUTILS_ELEVES = [];
async function loadOutils(){
  const rows = await pJson('/api/prof/comportement') || [];
  OUTILS_ELEVES = rows;
  renderComportement(rows);
  loadCeintures();
}
function renderComportement(rows){
  const box=document.getElementById('oc-table'); if(!box) return;
  if(!rows.length){ box.innerHTML='<div class="sub">Aucun élève — importe ta classe (onglet Import élèves).</div>'; return; }
  box.innerHTML='<table style="width:100%;border-collapse:collapse">'+
    '<tr><th style="text-align:left">Élève</th><th>Niveau</th><th>Points</th><th></th></tr>'+
    rows.map(e=>`<tr><td>${esc(e.prenom)} ${esc(e.nom)}</td><td style="text-align:center">${esc(e.niveau)}</td>`+
      `<td style="text-align:center;font-weight:700;color:${e.points<0?'var(--accent)':'var(--green)'}">${e.points}</td>`+
      `<td style="text-align:right;white-space:nowrap"><button class="btn secondary" onclick="cptDelta(${e.id},1)">＋</button> `+
      `<button class="btn secondary" onclick="cptDelta(${e.id},-1)">－</button></td></tr>`).join('')+'</table>';
}
async function cptDelta(id,delta){
  await pJson('/api/prof/comportement',{method:'POST',body:JSON.stringify({eleve_id:id,delta})});
  const rows=await pJson('/api/prof/comportement')||[]; OUTILS_ELEVES=rows; renderComportement(rows);
}
async function genProbleme(){
  const out=document.getElementById('om-out'); out.innerHTML='<div class="sub">Génération en cours… (0 token)</div>';
  const body={niveau:$('om-niveau').value,type:$('om-type').value,theme:$('om-theme').value,nb:+$('om-nb').value};
  const r=await pJson('/api/prof/probleme-maths',{method:'POST',body:JSON.stringify(body)});
  if(r&&r.contenu_md) out.innerHTML=md(r.contenu_md)+`<div class="sub" style="margin-top:8px">via ${esc(r.backend)}${r.cached?' (cache)':''} · 0 token</div>`;
  else out.innerHTML='<div class="sub">⚠️ '+esc((r&&r.error)||'Indisponible (surchauffe ?)')+'</div>';
}
async function genRituel(){
  const out=document.getElementById('or-out'); out.innerHTML='<div class="sub">Génération en cours… (0 token)</div>';
  const body={niveau:$('or-niveau').value,genre:$('or-genre').value,notion:$('or-notion').value};
  const r=await pJson('/api/prof/rituel',{method:'POST',body:JSON.stringify(body)});
  if(r&&r.contenu_md) out.innerHTML=md(r.contenu_md)+`<div class="sub" style="margin-top:8px">via ${esc(r.backend)}${r.cached?' (cache)':''} · 0 token</div>`;
  else out.innerHTML='<div class="sub">⚠️ '+esc((r&&r.error)||'Indisponible (surchauffe ?)')+'</div>';
}
async function loadCeintures(){
  const box=document.getElementById('oz-table'); if(!box) return;
  const d=await pJson('/api/prof/ceintures')||{}; const cs=d.couleurs||['blanche'];
  const optEleves=OUTILS_ELEVES.map(e=>`<option value="${e.id}">${esc(e.prenom)} ${esc(e.nom)}</option>`).join('');
  const optCoul=cs.map(c=>`<option value="${c}">${c}</option>`).join('');
  let html='<div class="form-row" style="margin-bottom:10px">'+
    `<div class="form-group"><label>Élève</label><select id="oz-eleve">${optEleves}</select></div>`+
    '<div class="form-group"><label>Domaine</label><input id="oz-domaine" placeholder="Lecture, Numération…"></div>'+
    `<div class="form-group"><label>Ceinture</label><select id="oz-couleur">${optCoul}</select></div>`+
    '<button class="btn" style="align-self:flex-end" onclick="setCeinture()">Attribuer</button></div>';
  const list=d.ceintures||[];
  if(list.length) html+='<table style="width:100%;border-collapse:collapse"><tr><th style="text-align:left">Élève</th><th style="text-align:left">Domaine</th><th>Ceinture</th></tr>'+
    list.map(c=>`<tr><td>${esc(c.prenom)} ${esc(c.nom)}</td><td>${esc(c.domaine)}</td><td style="text-align:center">${esc(c.couleur)}</td></tr>`).join('')+'</table>';
  else html+='<div class="sub">Aucune ceinture attribuée pour l\'instant.</div>';
  box.innerHTML=html;
}
async function setCeinture(){
  const body={eleve_id:+$('oz-eleve').value,domaine:$('oz-domaine').value,couleur:$('oz-couleur').value};
  if(!body.domaine){alert('Indique un domaine.');return;}
  const r=await pJson('/api/prof/ceintures',{method:'POST',body:JSON.stringify(body)});
  if(r&&r.error){alert(r.error);return;}
  $('oz-domaine').value=''; loadCeintures();
}

/* ── COMMANDES & BUDGET MATÉRIEL ── */
async function loadCommandes(){
  const b = await pJson('/api/commandes/budget') || {};
  if($('cb-total')  && document.activeElement!==$('cb-total'))   $('cb-total').value   = b.budget||'';
  if($('cb-reserve')&& document.activeElement!==$('cb-reserve')) $('cb-reserve').value = b.reserve||'';
  if($('cb-note')   && document.activeElement!==$('cb-note'))    $('cb-note').value    = b.note||'';
  renderCmdTotaux(b);
  loadCmdLignes();
}
function renderCmdTotaux(t){
  const box=$('cb-totaux'); if(!box) return;
  const e=n=>Number(n||0).toFixed(2); const reste=Number(t.reste||0);
  box.innerHTML=`Budget <b>${e(t.budget)} €</b> · réserve ${e(t.reserve)} € · disponible <b>${e(t.disponible)} €</b> · commandé ${e(t.total_commande)} € · reste <b style="color:${reste<0?'var(--accent)':'var(--green)'}">${e(reste)} €</b>`;
}
async function saveCmdBudget(){
  const body={total:+$('cb-total').value||0,reserve:+$('cb-reserve').value||0,note:$('cb-note').value};
  const r=await pJson('/api/commandes/budget',{method:'POST',body:JSON.stringify(body)});
  renderCmdTotaux(r||{}); loadCmdLignes();
}
async function loadCmdLignes(){
  const box=$('cl-table'); if(!box) return;
  const d=await pJson('/api/commandes/lignes')||{}; renderCmdTotaux(d);
  const list=d.lignes||[];
  if(!list.length){ box.innerHTML='<div class="sub">Aucune ligne — ajoute un article ou génère depuis tes besoins.</div>'; return; }
  box.innerHTML='<table style="width:100%;border-collapse:collapse">'+
    '<tr><th style="text-align:left">Article</th><th>Qté</th><th>Prix</th><th>Total</th><th style="text-align:left">Section</th><th></th></tr>'+
    list.map(l=>`<tr><td>${esc(l.article)}</td><td style="text-align:center">${esc(l.quantite)}</td>`+
      `<td style="text-align:right">${Number(l.prix||0).toFixed(2)} €</td><td style="text-align:right">${Number(l.total||0).toFixed(2)} €</td>`+
      `<td>${esc(l.section)}</td><td style="text-align:right"><button class="btn secondary" onclick="delCmdLigne(${l.id})">🗑️</button></td></tr>`).join('')+'</table>';
}
async function addCmdLigne(){
  const art=$('cl-article').value.trim(); if(!art){alert('Article requis.');return;}
  const body={article:art,quantite:$('cl-quantite').value,prix:+$('cl-prix').value||0,section:$('cl-section').value};
  const r=await pJson('/api/commandes/ligne',{method:'POST',body:JSON.stringify(body)});
  if(r&&r.error){alert(r.error);return;}
  $('cl-article').value='';$('cl-quantite').value='';$('cl-prix').value='';$('cl-section').value='';
  loadCmdLignes();
}
async function delCmdLigne(id){ await pFetch('/api/commandes/ligne/'+id,{method:'DELETE'}); loadCmdLignes(); }
async function genCommandes(){
  const msg=$('cg-msg'); const audit=$('cg-audit').value.trim();
  if(!audit){msg.innerHTML='⚠️ Colle d\'abord tes besoins.';return;}
  msg.innerHTML='Génération en cours… (0 token)';
  const r=await pJson('/api/commandes/generer',{method:'POST',body:JSON.stringify({audit})});
  if(r&&r.ok){ msg.innerHTML=`✅ ${r.ajoutees} ligne(s) via ${esc(r.backend||'IA')} · 0 token`; $('cg-audit').value=''; loadCmdLignes(); }
  else msg.innerHTML='⚠️ '+esc((r&&r.error)||'Indisponible');
}

/* ── PLAN B — contenus pré-générés (100% local, 0 IA) ── */
let PB_FICHES = [], PB_CURRENT = null, PB_DISPLAYED = '';
async function loadPlanB(){
  const sel=$('pb-niveau'); if(sel && !sel.options.length){
    sel.innerHTML=NIVEAUX.map(n=>`<option${n==='CE2'?' selected':''}>${n}</option>`).join('');
  }
  pbLoadNiveau();
}
async function pbLoadNiveau(){
  const niv=$('pb-niveau').value;
  PB_FICHES = await pJson('/api/banque?niveau='+encodeURIComponent(niv)) || [];
  const mats=[...new Set(PB_FICHES.map(f=>f.matiere))].sort();
  $('pb-matiere').innerHTML='<option value="">Toutes les matières</option>'+mats.map(m=>`<option>${esc(m)}</option>`).join('');
  pbRenderNotions();
  pbPlan();
}
async function pbPlan(){
  const box=$('pb-plan'); if(!box) return;
  // Délégation (une seule liaison) : évite toute injection JS dans un onclick inline (fix XSS).
  if(!box._bound){
    box.addEventListener('click', e=>{
      const b=e.target.closest('.pb-gen-btn'); if(!b) return;
      pbGenerer(b.dataset.matiere, b.dataset.notion, parseInt(b.dataset.periode||'1',10));
    });
    box._bound=true;
  }
  const niv=$('pb-niveau').value;
  const p=await pJson('/api/banque/plan?niveau='+encodeURIComponent(niv));
  if(!p||p.error){ box.innerHTML='<div class="sub">Plan indisponible.</div>'; return; }
  const cells=p.cells||[];
  box.innerHTML=(p.matieres||[]).map(m=>{
    const cs=cells.filter(c=>c.matiere===m);
    if(!cs.length) return '';
    return `<div style="margin:6px 0"><b>${esc(m)}</b> — `+cs.map(c=>
      c.fait
        ? `<span style="margin:2px;color:var(--muted,#888)">✅ ${esc(c.notion)}</span>`
        : `<button class="btn secondary pb-gen-btn" data-matiere="${esc(m)}" data-notion="${esc(c.notion)}" data-periode="${c.periode||1}" style="margin:2px;font-size:11px;padding:3px 8px">⬜ ${esc(c.notion)}</button>`
    ).join(' ')+`</div>`;
  }).join('')||'<div class="sub">Aucune notion au programme pour ce niveau.</div>';
}
async function pbGenerer(matiere,notion,periode){
  const niv=$('pb-niveau').value;
  if(!confirm('Générer la fiche « '+notion+' » ('+matiere+', '+niv+') ?\nIA locale 0-token, peut prendre un moment.')) return;
  const r=await pJson('/api/banque/generer',{method:'POST',body:JSON.stringify({niveau:niv,matiere,notion,periode})});
  if(!r||r.error){ alert('Échec : '+((r&&r.error)||'IA indisponible')); return; }
  await pbLoadNiveau();
}
async function pbBatch(){
  const niv=$('pb-niveau').value; const max=parseInt($('pb-batch-max').value||'3',10);
  if(!confirm('Générer un lot de '+max+' fiche(s) pour '+niv+' ?\nIA locale 0-token.')) return;
  const r=await pJson('/api/banque/batch',{method:'POST',body:JSON.stringify({niveau:niv,max})});
  if(!r||r.error){ alert('Échec : '+((r&&r.error)||'IA indisponible')); return; }
  alert('Lot terminé ('+(r.generes!=null?r.generes+' fiche(s)':'ok')+').'); await pbLoadNiveau();
}
function pbPdf(){
  const niv=$('pb-niveau').value; const mat=$('pb-matiere').value;
  window.open('/api/banque/pdf?niveau='+encodeURIComponent(niv)+(mat?'&matiere='+encodeURIComponent(mat):''),'_blank');
}
function pbRenderNotions(){
  const box=$('pb-notions'); if(!box) return;
  const mat=$('pb-matiere').value;
  const list=PB_FICHES.filter(f=>!mat||f.matiere===mat);
  if(!list.length){ box.innerHTML='<div class="sub">Aucune fiche ici — remplis la banque (onglet Année) ou change de niveau.</div>'; return; }
  box.innerHTML='<div class="sub" style="margin-bottom:6px">'+list.length+' fiche(s) prête(s) — clique pour afficher :</div>'+
    list.map(f=>`<button class="btn secondary" style="margin:3px" onclick="pbShow(${f.id})">${mat?'':esc(f.matiere)+' · '}${esc(f.notion)}</button>`).join('');
}
async function pbShow(id){
  const f=await pJson('/api/banque/cellule?id='+id); if(!f||f.error){alert('Fiche introuvable');return;}
  PB_CURRENT=f; PB_DISPLAYED=f.contenu_md||'';
  $('pb-titre').textContent=`${f.niveau} · ${f.matiere} — ${f.notion} (P${f.periode})`;
  $('pb-contenu').innerHTML=md(PB_DISPLAYED);
  $('pb-fiche-card').style.display='';
  $('pb-btn-court').style.display=''; $('pb-btn-full').style.display='none';
  $('pb-fiche-card').scrollIntoView({behavior:'smooth',block:'start'});
}
function pbExtraitSoutien(txt){
  const iS=txt.search(/soutien/i);
  if(iS<0) return null;
  const after=txt.slice(iS);
  const iNext=after.search(/standard|approfondiss/i);
  const bloc=iNext>0? after.slice(0,iNext) : after;
  // remonter au début de la ligne de titre du soutien
  const head=txt.slice(0,iS); const nl=head.lastIndexOf('\n');
  return (nl>=0?txt.slice(nl+1,iS):'')+bloc;
}
function pbCourt(){
  if(!PB_CURRENT) return;
  const s=pbExtraitSoutien(PB_CURRENT.contenu_md||'');
  if(!s){ alert('Pas de niveau « Soutien » détecté — version complète affichée.'); return; }
  PB_DISPLAYED='## ✂️ Version courte (Soutien)\n\n'+s;
  $('pb-contenu').innerHTML=md(PB_DISPLAYED);
  $('pb-btn-court').style.display='none'; $('pb-btn-full').style.display='';
}
function pbFull(){
  if(!PB_CURRENT) return;
