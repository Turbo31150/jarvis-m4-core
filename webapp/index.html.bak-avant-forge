function renderCal(){
  const g=document.getElementById('calGrid');if(!g)return;
  const fd=new Date(_cY,_cM,1).getDay(),dim=new Date(_cY,_cM+1,0).getDate(),tod=new Date();
  g.innerHTML='';
  ['Lun','Mar','Mer','Jeu','Ven','Sam','Dim'].forEach(d=>{const h=document.createElement('div');h.className='cal-head';h.textContent=d;g.appendChild(h);});
  const start=fd===0?6:fd-1;
  for(let i=0;i<start;i++){const c=document.createElement('div');c.className='cal-day other-month';g.appendChild(c);}
  for(let d=1;d<=dim;d++){
    const c=document.createElement('div');
    const isT=d===tod.getDate()&&_cM===tod.getMonth()&&_cY===tod.getFullYear();
    c.className='cal-day'+(isT?' today':'');
    const ds=`${_cY}-${String(_cM+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
    c.innerHTML=`<div class="dn">${d}</div>`;
    (window._rdv||[]).filter(r=>r.date===ds).forEach(r=>{
      const ev=document.createElement('div');ev.className=`cal-ev t-${r.type}`;
      ev.textContent=(r.heure_debut?r.heure_debut+' ':'')+r.titre;
      ev.title=r.titre+(r.description?' — '+r.description:'');
      ev.onclick=e=>{e.stopPropagation();if(confirm('Supprimer "'+r.titre+'" ?'))delRdv(r.id);};
      c.appendChild(ev);
    });
    c.onclick=()=>{const rd=document.getElementById('rDate');if(rd)rd.value=ds;};
    g.appendChild(c);
  }
  const ct=document.getElementById('calTitle');
  if(ct)ct.textContent=new Date(_cY,_cM).toLocaleDateString('fr-FR',{month:'long',year:'numeric'});
}
