let _cM=new Date().getMonth(),_cY=new Date().getFullYear();
window._rdv=[];
async function loadRdv(){
  try{const r=await fetch(`/api/rdv?year=${_cY}&month=${_cM+1}`);window._rdv=await r.json();}catch{window._rdv=[];}
