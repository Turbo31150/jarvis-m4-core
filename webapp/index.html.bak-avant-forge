let _rec=null,_chunks=[],_recTarget=null;
document.addEventListener('focusin',e=>{if(e.target&&(e.target.tagName==='TEXTAREA'||(e.target.tagName==='INPUT'&&(!e.target.type||e.target.type==='text'))))_recTarget=e.target;});
async function startDictee(btn){
  if(_rec&&_rec.state==='recording'){_rec.stop();return;}
  if(!_recTarget){alert('Clique d\'abord dans un champ texte, puis sur 🎤.');return;}
  try{
    const stream=await navigator.mediaDevices.getUserMedia({audio:true});
    _rec=new MediaRecorder(stream);_chunks=[];
    _rec.ondataavailable=e=>{if(e.data.size)_chunks.push(e.data);};
    _rec.onstop=async()=>{
      stream.getTracks().forEach(t=>t.stop());btn.textContent='⏳…';
      const blob=new Blob(_chunks);
      const b64=await new Promise(r=>{const fr=new FileReader();fr.onload=()=>r(fr.result.split(',')[1]);fr.readAsDataURL(blob);});
      const res=await pJson('/api/prof/dictee',{method:'POST',body:JSON.stringify({audio:b64,format:'webm'})});
      btn.textContent='🎤 Dicter';
      if(res.text){const t=_recTarget;t.value=(t.value?t.value+' ':'')+res.text;t.focus();}
      else alert('❌ '+(res.error||'rien transcrit'));
    };
    _rec.start();btn.textContent='⏹️ Stop (parle…)';
  }catch(e){alert('Micro inaccessible: '+e.message);}
}
