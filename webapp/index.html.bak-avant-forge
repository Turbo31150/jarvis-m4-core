const HIST_KEY = 'jarvis_chat_history';

function loadChatHistory() {
  const hist = JSON.parse(localStorage.getItem(HIST_KEY) || '[]');
  const el = document.getElementById('chat-history');
  el.innerHTML = hist.length
    ? ''
    : '<span style="color:var(--muted)">Historique vide. Posez votre première question !</span>';
  hist.forEach(item => {
    el.innerHTML += `<div class="msg-user">${escHtml(item.q)}</div>`;
    el.innerHTML += `<div class="msg-ai">${escHtml(item.a)}</div>`;
  });
  el.scrollTop = el.scrollHeight;
}

async function askJarvis() {
  const q       = document.getElementById('a-question').value.trim();
  const persona = document.getElementById('a-mode').value;
  if (!q) return;
  const el = document.getElementById('chat-history');
  // Remove placeholder
  const placeholder = el.querySelector('span');
  if (placeholder) placeholder.remove();
  el.innerHTML += `<div class="msg-user">${escHtml(q)}</div>`;
  const streamId = 'stream-' + Date.now();
  el.innerHTML += `<div class="msg-ai" id="${streamId}"><span class="spinner">⟳</span> Réflexion en cours…</div>`;
  el.scrollTop = el.scrollHeight;
  document.getElementById('a-question').value = '';
  try {
    const r = await fetch('/api/assistant', {
      method: 'POST',
      headers: {'Content-Type':'application/json'},
      body: JSON.stringify({prompt:q, persona})
    });
    const d = await r.json();
    const streamEl = document.getElementById(streamId);
    if (streamEl) streamEl.remove();
    if (d.texte) {
      const hist = JSON.parse(localStorage.getItem(HIST_KEY) || '[]');
      hist.push({q, a: d.texte, mode: persona, ts: new Date().toISOString()});
      if (hist.length > 50) hist.shift();
      localStorage.setItem(HIST_KEY, JSON.stringify(hist));
      el.innerHTML += `<div class="msg-ai">${escHtml(d.texte)}<br><small style="color:var(--muted)">[${escHtml(d.backend)}${d.cached?' · cache':''}]</small></div>`;
    } else {
      el.innerHTML += `<div class="msg-err">Erreur: ${escHtml(d.error || 'inconnu')}</div>`;
    }
  } catch(e) {
    const streamEl = document.getElementById(streamId);
    if (streamEl) streamEl.remove();
    el.innerHTML += `<div class="msg-err">Erreur réseau: ${escHtml(e.message)}</div>`;
  }
  el.scrollTop = el.scrollHeight;
}

function clearHistory() {
  localStorage.removeItem(HIST_KEY);
  loadChatHistory();
}

document.getElementById('a-question').addEventListener('keydown', e => {
  if (e.key === 'Enter' && e.ctrlKey) { e.preventDefault(); askJarvis(); }
});

