<style>
*,*::before,*::after{box-sizing:border-box;margin:0;padding:0}
:root{
  /* Palette « pousse / croissance » — thème clair, contrastes AA */
  --bg:#F6F4EC;--sidebar:#FBFAF4;--card:#FFFFFF;--border:#E2E6DC;
  --blue:#2F8F5B;--green:#1F6E45;--red:#C4452F;--orange:#E08A3C;
  --text:#26342B;--muted:#5E6B60;--font:system-ui,-apple-system,'Segoe UI',Roboto,'Helvetica Neue',Arial,sans-serif;
  --pousse-soft:#EAF3EC;--apricot-soft:#FBEEDD;--radius:14px;--radius-sm:10px;
  --shadow-sm:0 1px 2px rgba(38,52,43,.05),0 2px 8px rgba(38,52,43,.05);
  --shadow-md:0 4px 16px rgba(38,52,43,.08);
}
body{background:var(--bg);color:var(--text);font-family:var(--font);font-size:14px;line-height:1.55;display:flex;min-height:100vh;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}

/* NAV / SIDEBAR */
#sidebar{width:212px;min-width:212px;background:var(--sidebar);border-right:1px solid var(--border);display:flex;flex-direction:column;padding:20px 0 12px;position:sticky;top:0;height:100vh;overflow-y:auto}
#sidebar .logo{padding:0 20px 22px;font-size:20px;font-weight:800;color:var(--green);letter-spacing:-.4px;line-height:1.1}
#sidebar .logo span{color:var(--blue)}
nav{display:flex;flex-direction:column;gap:2px;padding:0 8px}
nav a{position:relative;display:flex;align-items:center;gap:11px;padding:10px 12px;margin:0 4px;color:var(--muted);text-decoration:none;border-radius:10px;border-left:3px solid transparent;font-weight:500;transition:background .2s,color .2s}
nav a:hover{color:var(--text);background:var(--pousse-soft)}
nav a.active{color:var(--green);background:var(--pousse-soft);font-weight:650;border-left-color:var(--blue)}
nav a.active::after{content:"";position:absolute;right:12px;top:50%;width:9px;height:9px;background:var(--blue);border-radius:0 70% 0 70%;transform:translateY(-50%) rotate(45deg);box-shadow:0 0 0 3px rgba(47,143,91,.12)}
nav a .icon{font-size:16px;width:20px;text-align:center;flex-shrink:0}
#sidebar .version{margin-top:auto;padding:14px 20px 4px;font-size:11px;color:var(--muted);opacity:.85}

#main{flex:1;overflow-y:auto;min-width:0}
.section{display:none;padding:28px 32px}
.section.active{display:block}

h2{font-size:23px;font-weight:800;letter-spacing:-.5px;margin-bottom:22px;color:var(--green)}
h3{font-size:15px;font-weight:700;letter-spacing:-.2px;margin-bottom:12px;color:var(--text)}

/* CARTES */
.cards{display:flex;flex-wrap:wrap;gap:18px;margin-bottom:26px}
.card{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px 20px;min-width:160px;flex:1;box-shadow:var(--shadow-sm);transition:transform .18s,box-shadow .18s,border-color .18s}
.card:hover{border-color:#CFE0D2;box-shadow:var(--shadow-md);transform:translateY(-2px)}
.card .label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.8px;font-weight:600;margin-bottom:8px}
.card .value{font-size:30px;font-weight:800;letter-spacing:-.5px;color:var(--text)}
.card .sub{font-size:12px;color:var(--muted);margin-top:5px}
.c-green{color:var(--green)}.c-red{color:var(--red)}.c-orange{color:var(--orange)}.c-blue{color:var(--blue)}

/* TABLEAUX */
.tbl-wrap{overflow-x:auto;margin-bottom:22px;border:1px solid var(--border);border-radius:var(--radius);background:var(--card);box-shadow:var(--shadow-sm)}
table{width:100%;border-collapse:collapse;font-size:13px}
th{background:var(--pousse-soft);color:var(--green);padding:11px 14px;text-align:left;border-bottom:1px solid var(--border);font-weight:700;text-transform:uppercase;font-size:11px;letter-spacing:.6px}
td{padding:10px 14px;border-bottom:1px solid var(--border);color:var(--text)}
tr:last-child td{border-bottom:none}
tr:hover td{background:#FBFCFA}

/* FORMULAIRES */
.form-row{display:flex;flex-wrap:wrap;gap:14px;margin-bottom:18px;align-items:flex-end}
.form-group{display:flex;flex-direction:column;gap:6px;min-width:120px;flex:1}
.form-group label{font-size:11px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;font-weight:600}
input,select,textarea{background:var(--card);border:1px solid var(--border);color:var(--text);padding:9px 13px;border-radius:var(--radius-sm);font-family:var(--font);font-size:13px;outline:none;width:100%;transition:border-color .18s,box-shadow .18s}
input::placeholder,textarea::placeholder{color:var(--muted);opacity:.7}
input:hover,select:hover,textarea:hover{border-color:#CFE0D2}
input:focus,select:focus,textarea:focus{border-color:var(--blue);box-shadow:0 0 0 3px rgba(47,143,91,.18)}
textarea{resize:vertical;min-height:84px;line-height:1.5}

/* BOUTONS pill */
.btn{background:var(--blue);color:#fff;border:none;padding:9px 20px;border-radius:999px;font-family:var(--font);font-size:13px;font-weight:650;cursor:pointer;transition:background .18s,box-shadow .18s,transform .12s;white-space:nowrap;box-shadow:0 1px 2px rgba(38,52,43,.12)}
.btn:hover{background:var(--green)}
.btn:active{transform:translateY(1px)}
.btn.secondary{background:var(--card);border:1px solid var(--border);color:var(--text);box-shadow:none}
.btn.secondary:hover{border-color:var(--blue);color:var(--green);background:var(--pousse-soft)}
.btn.danger{background:var(--red);color:#fff}
.btn.danger:hover{background:#A6371F}

/* PLANNING */
.planning-grid{display:grid;grid-template-columns:62px repeat(5,1fr);gap:4px;margin-bottom:22px;font-size:12px}
.pg-header{background:var(--pousse-soft);padding:9px 6px;text-align:center;border-radius:var(--radius-sm);font-size:11px;color:var(--green);text-transform:uppercase;font-weight:700;letter-spacing:.4px}
.pg-header.today{color:#fff;background:var(--blue);border:1px solid var(--blue)}
.pg-hour{background:#EFEFE6;padding:7px;text-align:center;color:var(--muted);border-radius:var(--radius-sm);font-size:11px;font-weight:600}
.pg-cell{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);min-height:50px;padding:5px;position:relative}
.pg-cours{background:rgba(47,143,91,.12);border-left:3px solid var(--blue);padding:5px 7px;border-radius:6px;font-size:11px;line-height:1.45;color:var(--text)}
.pg-cours.current-day{background:var(--apricot-soft);border-left-color:var(--orange)}

/* BUDGET */
.budget-top{display:flex;gap:22px;margin-bottom:26px;flex-wrap:wrap}
.solde-box{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:22px 30px;text-align:center;min-width:200px;box-shadow:var(--shadow-sm)}
.solde-box .label{font-size:12px;color:var(--muted);text-transform:uppercase;letter-spacing:.6px;font-weight:600;margin-bottom:6px}
.solde-box .amount{font-size:38px;font-weight:800;letter-spacing:-1px;color:var(--green)}
svg.pie{overflow:visible}

/* CHAT / ASSISTANT */
#chat-history{background:var(--card);border:1px solid var(--border);border-radius:var(--radius);padding:18px;min-height:200px;max-height:400px;overflow-y:auto;margin-bottom:16px;font-size:13px;line-height:1.65;box-shadow:var(--shadow-sm)}
.msg-user{color:var(--green);margin-bottom:14px}
.msg-user::before{content:"▶ Vous : ";font-weight:700}
.msg-ai{color:var(--text);margin-bottom:14px;white-space:pre-wrap}
.msg-ai::before{content:"◆ Pousseline : ";font-weight:700;color:var(--blue)}
.msg-err{color:var(--red);margin-bottom:14px}
.spinner{display:inline-block;animation:spin 1s linear infinite}
@keyframes spin{to{transform:rotate(360deg)}}

/* DOCS */
.doc-tree{font-size:13px}
.doc-item{padding:5px 9px;cursor:pointer;border-radius:8px;display:flex;align-items:center;gap:8px;color:var(--text)}
.doc-item:hover{background:var(--pousse-soft);color:var(--green)}
.doc-children{margin-left:20px;border-left:1px solid var(--border);padding-left:2px}
.doc-dir::before{content:"📁 "}
.doc-file::before{content:"📄 "}

/* SYSTÈME / STATUTS */
.sys-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(200px,1fr));gap:16px;margin-bottom:22px}
.status-dot{display:inline-block;width:9px;height:9px;border-radius:50%;margin-right:7px;vertical-align:middle}
.dot-green{background:var(--green);box-shadow:0 0 0 3px rgba(31,110,69,.15)}
.dot-red{background:var(--red);box-shadow:0 0 0 3px rgba(196,69,47,.15)}
.dot-orange{background:var(--orange);box-shadow:0 0 0 3px rgba(224,138,60,.15)}

/* CITATION */
.citation{background:var(--apricot-soft);border-left:4px solid var(--orange);padding:14px 18px;border-radius:0 var(--radius) var(--radius) 0;margin-bottom:22px;font-style:italic;color:#7A5326}

.shortcuts{display:flex;gap:12px;flex-wrap:wrap;margin-bottom:22px}

/* BADGES */
.badge{display:inline-block;padding:3px 10px;border-radius:999px;font-size:11px;font-weight:650}
.badge-green{background:var(--pousse-soft);color:var(--green);border:1px solid rgba(31,110,69,.25)}
.badge-red{background:rgba(196,69,47,.1);color:var(--red);border:1px solid rgba(196,69,47,.28)}
.badge-orange{background:var(--apricot-soft);color:#A65E1C;border:1px solid rgba(224,138,60,.32)}

/* DIVERS */
.filter-row{display:flex;gap:12px;margin-bottom:14px;align-items:center;flex-wrap:wrap}
.filter-row label{font-size:12px;color:var(--muted);font-weight:500}
hr{border:none;border-top:1px solid var(--border);margin:22px 0}
.msg{padding:10px 14px;border-radius:var(--radius-sm);font-size:12px;margin-bottom:10px}
.msg-ok{background:var(--pousse-soft);border:1px solid rgba(31,110,69,.25);color:var(--green)}
.msg-ko{background:rgba(196,69,47,.1);border:1px solid rgba(196,69,47,.28);color:var(--red)}

/* HORLOGE / CALENDRIER */
#clock{font-size:34px;font-weight:800;color:var(--green);letter-spacing:1px;margin-bottom:4px}
#date-str{font-size:13px;color:var(--muted);margin-bottom:22px}
.cal-nav{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:22px}
.cal-head{background:var(--pousse-soft);padding:9px 4px;text-align:center;font-size:11px;color:var(--green);border-radius:var(--radius-sm);text-transform:uppercase;font-weight:700;letter-spacing:.4px}
.cal-day{background:var(--card);border:1px solid var(--border);border-radius:var(--radius-sm);min-height:74px;padding:7px;cursor:pointer;transition:border-color .18s,box-shadow .18s}
.cal-day:hover{border-color:#CFE0D2;box-shadow:var(--shadow-sm)}
.cal-day.today{border-color:var(--blue);background:var(--pousse-soft)}
.cal-day.other-month{opacity:.4}
.cal-day .dn{font-size:13px;font-weight:700;margin-bottom:4px;color:var(--text)}
.cal-day.today .dn{color:var(--green)}
.cal-ev{font-size:10px;padding:2px 5px;border-radius:4px;margin-bottom:2px;overflow:hidden;white-space:nowrap;text-overflow:ellipsis;border-left:2px solid var(--blue);background:rgba(47,143,91,.12);color:var(--text)}
.cal-ev.t-cours{border-left-color:var(--green);background:rgba(31,110,69,.12)}
.cal-ev.t-perso{border-left-color:var(--orange);background:var(--apricot-soft)}
.cal-ev.t-reunion{border-left-color:var(--red);background:rgba(196,69,47,.1)}

/* BARRE VOCALE */
.voice-bar{padding:12px 18px;border-top:1px solid var(--border);display:flex;align-items:center;gap:11px;background:var(--sidebar)}
.vbtn{background:var(--card);border:2px solid var(--border);color:var(--green);width:40px;height:40px;border-radius:50%;font-size:17px;cursor:pointer;transition:background .25s,border-color .25s,transform .25s;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.vbtn:hover{border-color:var(--blue);background:var(--pousse-soft)}
.vbtn.rec{background:rgba(196,69,47,.12);border-color:var(--red);color:var(--red);animation:vp 1s infinite}
@keyframes vp{0%,100%{transform:scale(1)}50%{transform:scale(1.12)}}
.vstatus{font-size:11px;color:var(--muted);flex:1;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}

/* FOCUS CLAVIER VISIBLE */
a:focus-visible,button:focus-visible,.btn:focus-visible,input:focus-visible,select:focus-visible,textarea:focus-visible,.doc-item:focus-visible,.cal-day:focus-visible,.vbtn:focus-visible,nav a:focus-visible{outline:3px solid var(--orange);outline-offset:2px;border-radius:8px}

/* RESPONSIVE nav horizontale < 768px */
@media (max-width:768px){
  body{flex-direction:column;font-size:15px}
  #sidebar{width:100%;min-width:0;height:auto;position:sticky;top:0;z-index:50;flex-direction:row;flex-wrap:wrap;padding:8px 10px;overflow-x:auto;align-items:center;border-right:none;border-bottom:1px solid var(--border)}
  #sidebar .logo{padding:6px 10px;font-size:17px;width:100%}
  nav{flex-direction:row;flex-wrap:wrap;gap:4px;width:100%;padding:0}
  nav a{padding:8px 13px;margin:0;border-left:none;border-bottom:3px solid transparent;border-radius:999px;font-size:13px}
  nav a:hover,nav a.active{border-left:none;border-bottom-color:var(--blue);background:var(--pousse-soft)}
  nav a.active::after{display:none}
  #sidebar .version{margin-top:0;padding:6px 10px;width:100%}
  #main{width:100%}
  .section{padding:16px}
  .card,[class*="card"]{min-width:0!important}
}

/* RESPONSIVE icônes seules < 700px */
@media(max-width:700px){
  #sidebar{width:100%;flex-direction:row}
  #sidebar .logo,nav a span,#sidebar .version{display:none}
  nav a{justify-content:center;padding:11px 13px}
}

/* MOUVEMENT RÉDUIT */
@media (prefers-reduced-motion:reduce){
  *,*::before,*::after{animation-duration:.001ms!important;animation-iteration-count:1!important;transition-duration:.001ms!important;scroll-behavior:auto!important}
}
</style>
</head>
