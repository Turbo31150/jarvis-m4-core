function renderTree(nodes) {
  return nodes.map(n => {
    if (n.type === 'dir') {
      const children = n.children && n.children.length ? renderTree(n.children) : '';
      return `<div class="doc-item doc-dir" onclick="openDoc(${JSON.stringify(n.path)})">${escHtml(n.name)}</div>
              <div class="doc-children">${children}</div>`;
    }
    return `<div class="doc-item doc-file" onclick="openDoc(${JSON.stringify(n.path)})">${escHtml(n.name)}</div>`;
  }).join('');
}

/* Types gérés dans le navigateur (pas besoin de xdg-open côté serveur) */
const DOC_TEXTE = ['md','txt','csv','json','html','htm','xml','yaml','yml','log','ini','conf','tex','rst','org','markdown'];
const DOC_VIEW  = ['pdf','png','jpg','jpeg','gif','svg','webp','bmp'];
let _docPath = null;

function _ext(p){ const m = p.split('.').pop(); return m ? m.toLowerCase() : ''; }

function openDoc(path) {
  const ext = _ext(path);
  const isDir = !path.includes('.') || path.split('/').pop().indexOf('.') < 0;
  if (DOC_TEXTE.includes(ext)) {          // consulter + modifier + enregistrer
    editDoc(path);
  } else if (DOC_VIEW.includes(ext)) {     // consulter dans le navigateur (PDF/image)
    window.open('/api/file?path=' + encodeURIComponent(path), '_blank');
  } else if (isDir) {                      // dossier → gestionnaire de fichiers local
    fetch('/api/open?path=' + encodeURIComponent(path)).catch(() => {});
  } else {                                 // docx/odt/xlsx… → télécharger, éditable hors-ligne
    window.open('/api/file?path=' + encodeURIComponent(path), '_blank');
  }
}

async function editDoc(path) {
  const ed = document.getElementById('doc-editor');
  const st = document.getElementById('doc-editor-status');
  ed.style.display = 'block';
  document.getElementById('doc-editor-name').textContent = path.split('/').pop();
  document.getElementById('doc-editor-text').value = 'Chargement…';
  st.textContent = '';
  _docPath = null;
  try {
    const r = await fetch('/api/file-content?path=' + encodeURIComponent(path)).then(r => r.json());
    if (!r.ok) { st.textContent = '⚠ ' + (r.error || 'erreur'); return; }
    if (!r.editable) {                     // binaire → ouvrir en consultation
      ed.style.display = 'none';
      window.open('/api/file?path=' + encodeURIComponent(path), '_blank');
      return;
    }
    document.getElementById('doc-editor-text').value = r.text;
    _docPath = r.path;
    st.textContent = 'prêt';
    ed.scrollIntoView({behavior:'smooth', block:'nearest'});
  } catch(e){ st.textContent = '⚠ réseau'; }
}

async function saveDoc() {
  if (!_docPath) return;
  const st = document.getElementById('doc-editor-status');
  const btn = document.getElementById('doc-save-btn');
  btn.disabled = true; st.textContent = 'enregistrement…';
  try {
    const r = await fetch('/api/file-save', {
      method:'POST', headers:{'Content-Type':'application/json'},
      body: JSON.stringify({path:_docPath, text:document.getElementById('doc-editor-text').value})
    }).then(r => r.json());
    st.textContent = r.ok ? '✅ enregistré (' + r.octets + ' o)' : '⚠ ' + (r.error || 'échec');
  } catch(e){ st.textContent = '⚠ réseau'; }
  btn.disabled = false;
}

function closeDocEditor() {
  document.getElementById('doc-editor').style.display = 'none';
  _docPath = null;
}

