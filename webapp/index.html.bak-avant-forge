const CAT_COLORS = ['#4a9eff','#00d4aa','#ff4a4a','#ffaa00','#cc88ff','#ff88aa','#44ddff','#ffdd44','#88ff88','#aaaaaa'];

async function loadBudget() {
  const rows = await fetch('/api/budget').then(r => r.json()).catch(() => []);
  const tbody = document.querySelector('#budget-table tbody');
  tbody.innerHTML = '';
  let revenus = 0, depenses = 0;
  const catMap = {};
  rows.forEach(r => {
    if (r.type === 'revenu') revenus += r.montant;
    else {
      depenses += r.montant;
      catMap[r.categorie] = (catMap[r.categorie] || 0) + r.montant;
    }
    const sign = r.type === 'revenu' ? 1 : -1;
    const cls = r.type === 'revenu' ? 'c-green' : 'c-red';
    tbody.innerHTML += `<tr>
      <td>${escHtml(r.date)}</td>
      <td><span class="badge ${r.type==='revenu'?'badge-green':'badge-red'}">${escHtml(r.type)}</span></td>
      <td>${escHtml(r.categorie)}</td>
      <td class="${cls}">${sign > 0 ? '+' : '-'}${Math.abs(r.montant).toFixed(2)} €</td>
      <td>${escHtml(r.description || '')}</td>
    </tr>`;
  });
  const solde = revenus - depenses;
  const sel = document.getElementById('solde');
  sel.textContent = (solde >= 0 ? '+' : '') + solde.toFixed(2) + ' €';
  sel.className = 'amount ' + (solde >= 0 ? 'c-green' : 'c-red');
  drawPie(catMap);
}

function drawPie(catMap) {
  const cats = Object.keys(catMap);
  const total = cats.reduce((s, c) => s + catMap[c], 0);
  const svg = document.getElementById('pie-svg');
  const legend = document.getElementById('pie-legend');
  svg.innerHTML = '';
  legend.innerHTML = '<div style="font-size:11px;color:var(--muted);margin-bottom:8px">Dépenses par catégorie</div>';
  if (total === 0) { svg.innerHTML = '<circle r="1" fill="#2e333d"/>'; return; }
  let startAngle = 0;
  cats.forEach((cat, i) => {
    const slice = catMap[cat] / total;
    const endAngle = startAngle + slice * 2 * Math.PI;
    const x1 = Math.cos(startAngle), y1 = Math.sin(startAngle);
    const x2 = Math.cos(endAngle),   y2 = Math.sin(endAngle);
    const large = slice > 0.5 ? 1 : 0;
    const color = CAT_COLORS[i % CAT_COLORS.length];
    const path = document.createElementNS('http://www.w3.org/2000/svg','path');
    path.setAttribute('d', `M 0 0 L ${x1} ${y1} A 1 1 0 ${large} 1 ${x2} ${y2} Z`);
    path.setAttribute('fill', color);
    svg.appendChild(path);
    legend.innerHTML += `<div style="font-size:11px;margin:2px 0"><span style="display:inline-block;width:10px;height:10px;background:${color};border-radius:2px;margin-right:6px;vertical-align:middle"></span>${escHtml(cat)}: ${catMap[cat].toFixed(0)} €</div>`;
    startAngle = endAngle;
  });
}

