<!-- 2. PLANNING ─────────────────────────────────────────────────────────── -->
<div id="section-planning" class="section">
  <h2>📅 Mes plannings</h2>
  <p class="sub" style="margin-bottom:14px">Deux plannings bien distincts, alimentés uniquement par tes données : ton <b>Espace professeur</b> et ta <b>vie personnelle</b>.</p>

  <div style="border-left:4px solid var(--green,#3a9d5d);padding-left:12px;margin-bottom:8px">
    <h3 style="color:var(--green,#3a9d5d);margin:0">📚 Planning professionnel <span class="sub">— Espace prof</span></h3>
  </div>
  <div class="planning-grid" id="planning-grid-pro"></div>

  <div style="border-left:4px solid var(--blue,#4a9eff);padding-left:12px;margin:22px 0 8px">
    <h3 style="color:var(--blue,#4a9eff);margin:0">🏡 Planning vie personnelle <span class="sub">— Claire</span></h3>
  </div>
  <div class="planning-grid" id="planning-grid-perso"></div>

  <h3 style="margin-top:22px">Ajouter au planning</h3>
  <div class="form-row">
    <div class="form-group"><label>Planning</label>
      <select id="p-cat">
        <option value="pro">📚 Professionnel</option>
        <option value="perso">🏡 Vie perso</option>
      </select>
    </div>
    <div class="form-group">
      <label>Jour</label>
      <select id="p-jour">
        <option>Lundi</option><option>Mardi</option><option>Mercredi</option>
        <option>Jeudi</option><option>Vendredi</option>
      </select>
    </div>
    <div class="form-group"><label>Heure début</label><input id="p-heure" type="time" value="08:00"></div>
    <div class="form-group"><label>Durée</label>
      <select id="p-duree">
        <option value="1h">1h</option><option value="1h30">1h30</option>
        <option value="2h">2h</option><option value="3h">3h</option>
      </select>
    </div>
