[Unit]
Description=JARVIS Cluster Monitor Server
After=network.target

[Service]
Type=simple
User=turbo
WorkingDirectory=/home/pamerys/jarvis/monitoring
ExecStart=/usr/bin/python3 /home/pamerys/jarvis/monitoring/server.py
Restart=on-failure
RestartSec=5
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
