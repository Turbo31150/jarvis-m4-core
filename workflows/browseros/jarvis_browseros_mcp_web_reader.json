{
  "name": "JARVIS — BrowserOS MCP Web Reader",
  "active": false,
  "nodes": [
    {
      "parameters": {},
      "id": "11111111-1111-1111-1111-111111111111",
      "name": "Manual Trigger",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [
        240,
        300
      ]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "a1",
              "name": "targetUrl",
              "value": "https://example.com",
              "type": "string"
            },
            {
              "id": "a2",
              "name": "mcpUrl",
              "value": "http://127.0.0.1:9003/mcp",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
      "id": "22222222-2222-2222-2222-222222222222",
      "name": "Config",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [
        460,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.mcpUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json, text/event-stream"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": 1,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"tabs\",\n    \"arguments\": { \"action\": \"new\", \"url\": \"{{ $json.targetUrl }}\", \"background\": true }\n  }\n}",
        "options": {}
      },
      "id": "33333333-3333-3333-3333-333333333333",
      "name": "MCP: Open Tab",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        680,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Extrait le pageId du texte MCP \"opened page N\"\nconst txt = $json?.result?.content?.[0]?.text || '';\nconst m = txt.match(/page\\s+(\\d+)/i);\nif (!m) throw new Error('pageId introuvable dans: ' + txt);\nreturn [{ json: { pageId: parseInt(m[1], 10), mcpUrl: $('Config').item.json.mcpUrl } }];"
      },
      "id": "44444444-4444-4444-4444-444444444444",
      "name": "Extract pageId",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $json.mcpUrl }}",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Content-Type",
              "value": "application/json"
            },
            {
              "name": "Accept",
              "value": "application/json, text/event-stream"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"jsonrpc\": \"2.0\",\n  \"id\": 2,\n  \"method\": \"tools/call\",\n  \"params\": {\n    \"name\": \"read\",\n    \"arguments\": { \"pageId\": {{ $json.pageId }}, \"format\": \"markdown\" }\n  }\n}",
        "options": {}
      },
      "id": "55555555-5555-5555-5555-555555555555",
      "name": "MCP: Read Page",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [
        1120,
        300
      ]
    },
    {
      "parameters": {
        "jsCode": "// Sortie : markdown extrait de la page\nconst md = $json?.result?.content?.[0]?.text || '(vide)';\nreturn [{ json: { markdown: md, length: md.length } }];"
      },
      "id": "66666666-6666-6666-6666-666666666666",
      "name": "Result",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1340,
        300
      ]
    }
  ],
