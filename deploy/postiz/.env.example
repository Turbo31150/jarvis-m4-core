# ─────────────────────────────────────────────────────────────────────────────
# Postiz — variables d'environnement (MODÈLE). Copier en .env et remplir.
#   cp .env.example .env
#
# RÈGLE SÉCURITÉ JARVIS : aucun secret en clair ici ni dans git.
#   - .env est gitignoré (ne jamais le committer).
#   - Générer/stocker les secrets dans le coffre sops+age : ~/jarvis/secrets-vault
#     (clé age : ~/.config/sops/age/keys.txt — à sauvegarder hors-ligne).
#   - Les tokens OAuth des réseaux sociaux se saisissent DANS l'UI Postiz,
#     pas ici (Postiz les chiffre en base).
# ─────────────────────────────────────────────────────────────────────────────

# URLs publiques — adapter à l'hôte réel (IP LAN ou domaine).
POSTIZ_MAIN_URL=http://localhost:4200
POSTIZ_FRONTEND_URL=http://localhost:4200
POSTIZ_BACKEND_URL=http://localhost:4200/api

# Secret de session JWT — chaîne aléatoire longue.
#   Générer :  openssl rand -hex 32
#   Stocker dans le coffre, ne jamais committer la valeur.
POSTIZ_JWT_SECRET=

# Base Postgres (interne au compose).
POSTIZ_DB_USER=postiz
POSTIZ_DB_PASSWORD=
POSTIZ_DB_NAME=postiz

# Fermer l'inscription publique une fois le 1er compte admin créé.
POSTIZ_DISABLE_REGISTRATION=false
