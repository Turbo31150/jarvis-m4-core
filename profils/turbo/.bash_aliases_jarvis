# JARVIS Prompt
export PS1="\[\033[01;36m\][JARVIS OS]\[\033[00m\] \[\033[01;32m\]\u@\h\[\033[00m\]:\[\033[01;34m\]\w\[\033[00m\]\$ "
function j_audit() {
    clear
    echo -e "\e[1;36m[JARVIS OS v13.1] COGNITIVE AUDIT IN PROGRESS...\e[0m"
    sleep 1
    echo -e "\e[1;34m[CORE] OS-Release: \e[1;32m$(grep PRETTY_NAME /etc/os-release | cut -d= -f2 | tr -d \")\e[0m"
    echo -e "\e[1;34m[NODE] Hostname: \e[1;32m$(hostname)\e[0m"
    echo -e "\e[1;34m[DATA] Memory: \e[1;32m$(free -h | grep Mem | awk \"{print \$3 \\\"/\\\" \$2}\")\e[0m"
    echo -e "\e[1;34m[DATA] Disk: \e[1;32m$(df -h / | tail -1 | awk \"{print \$3 \\\"/\\\" \$2}\")\e[0m"
    echo -e "\e[1;34m[GPU]  Cluster: \e[1;32m$(nvidia-smi --query-gpu=name --format=csv,noheader | wc -l) GPUs Active\e[0m"
    echo -e "\e[1;34m[IA]   Agents: \e[1;32m7 Active\e[0m"
    echo -e "\e[1;36m[JARVIS OS] AUDIT COMPLETED.\e[0m"
}
alias jaudit="j_audit"
