{"updatedAt":"2026-03-19T16:52:53.234Z","createdAt":"2026-03-19T16:52:53.234Z","id":"q2dJVv9dmuLM88Kq","name":"JARVIS — Docker Log Analyzer","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":2}]}},"id":"log-t","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[250,300]},{"parameters":{"method":"POST","url":"http://127.0.0.1:9742/api/logs/ingest","options":{"timeout":30000}},"id":"log-i","name":"POST Ingest Logs","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[470,300]},{"parameters":{"url":"http://127.0.0.1:9742/api/logs/search?level=ERROR&limit=50","options":{"timeout":15000}},"id":"log-s","name":"GET Error Logs","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[690,300]},{"parameters":{"jsCode":"const data=$input.all()[0].json;\nconst logs=data.results||data.logs||data||[];\nconst grouped={};\nlet criticalCount=0;\nconst logArr=Array.isArray(logs)?logs:[];\nfor(const log of logArr){const svc=log.service||log.container||log.source||\"unknown\";if(!grouped[svc])grouped[svc]=[];grouped[svc].push({message:log.message||log.msg,timestamp:log.timestamp||log.time});const msg=(log.message||log.msg||\"\").toLowerCase();if(msg.includes(\"fatal\")||msg.includes(\"critical\")||msg.includes(\"panic\")||msg.includes(\"oom\")){criticalCount++;}}\nconst summary=Object.keys(grouped).map(svc=>({service:svc,errorCount:grouped[svc].length}));\nreturn[{json:{summary,totalErrors:logArr.length,criticalCount,hasCritical:criticalCount>0,checkedAt:new Date().toISOString()}}];"},"id":"log-c","name":"Group Errors by Service","type":"n8n-nodes-base.code","typeVersion":2,"position":[910,300]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"log-c1","leftValue":"={{ $json.hasCritical }}","rightValue":true,"operator":{"type":"boolean","operation":"equals","singleValue":true}}],"combinator":"and"},"options":{}},"id":"log-if","name":"IF Critical Errors","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[1130,300]},{"parameters":{"method":"POST","url":"http://127.0.0.1:9742/api/notify","sendBody":true,"bodyParameters":{"parameters":[{"name":"message","value":"=DOCKER LOG ALERT: {{ $json.criticalCount }} critical errors across {{ $json.summary.length }} services. Top: {{ $json.summary.slice(0,3).map(s => s.service + \"(\" + s.errorCount + \")\").join(\", \") }}"},{"name":"level","value":"critical"},{"name":"source","value":"n8n-docker-log-analyzer"}]},"options":{}},"id":"log-n","name":"POST Notify Critical Logs","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1350,200]}],"connections":{"Schedule Trigger":{"main":[[{"node":"POST Ingest Logs","type":"main","index":0}]]},"POST Ingest Logs":{"main":[[{"node":"GET Error Logs","type":"main","index":0}]]},"GET Error Logs":{"main":[[{"node":"Group Errors by Service","type":"main","index":0}]]},"Group Errors by Service":{"main":[[{"node":"IF Critical Errors","type":"main","index":0}]]},"IF Critical Errors":{"main":[[{"node":"POST Notify Critical Logs","type":"main","index":0}],[]]}},"settings":{"executionOrder":"v1","callerPolicy":"workflowsFromSameOwner","availableInMCP":false},"staticData":{"node:Schedule Trigger":{"recurrenceRules":[8]}},"meta":null,"nodeGroups":[],"pinData":null,"versionId":"d0340396-0902-486f-85db-da4454224e6d","activeVersionId":"d0340396-0902-486f-85db-da4454224e6d","versionCounter":1941,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-03-19T16:52:53.235Z","createdAt":"2026-03-19T16:52:53.235Z","role":"workflow:owner","workflowId":"q2dJVv9dmuLM88Kq","projectId":"SvBenKSzeDz1VaKl","project":{"updatedAt":"2026-06-25T12:29:44.000Z","createdAt":"2026-03-12T03:56:07.666Z","id":"SvBenKSzeDz1VaKl","name":"Franck Delmas <franckdelmas00@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"c