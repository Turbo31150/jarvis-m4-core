ma) }\n];\n\nconst downServices = services.filter(s => !s.up);\nconst hasAlert = downServices.length > 0;\n\nconst lines = services.map(s => {\n  const icon = s.up ? '✅' : '❌';\n  return `${icon} ${s.name}: ${s.status.toUpperCase()}`;\n}).join('\\n');\n\nconst now = new Date().toLocaleTimeString('fr-FR');\nconst overallStatus = hasAlert ? `🚨 ${downServices.length} SERVICE(S) DOWN` : '✅ ALL SYSTEMS GO';\n\nconst message = `🔧 *JARVIS Watchdog — ${now}*\\n*${overallStatus}*\\n\\n${lines}\\n\\n━━━━━━━━━━━━━━━━\\n_Auto-check toutes les 2min_`;\n\nreturn [{ json: { services, downServices, hasAlert, message, now } }];"},"id":"sh-n6","name":"Analyser Statut Services","type":"n8n-nodes-base.code","typeVersion":2,"position":[660,340]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"leftValue":"={{ $json.hasAlert }}","rightValue":true,"operator":{"type":"boolean","operation":"equal"}}],"combinator":"and"}},"id":"sh-n7","name":"Service(s) DOWN?","type":"n8n-nodes-base.if","typeVersion":2,"position":[900,340]},{"parameters":{"url":"http://127.0.0.1:8080/mcp","method":"POST","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"tool\": \"speak\",\n  \"text\": \"ALERTE WATCHDOG. {{ $json.downServices.length }} service JARVIS hors ligne. Auto-réparation en cours.\"\n}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"id":"sh-n8","name":"JARVIS — Alerte Vocale Service DOWN","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1140,220],"continueOnFail":true,"credentials":{"httpHeaderAuth":{"id":"fAsADvvR1C8MIjSp","name":"JARVIS MCP Bearer"}}},{"parameters":{"url":"http://127.0.0.1:8080/mcp","method":"POST","sendBody":true,"specifyBody":"json","jsonBody":"{\"tool\":\"bash_run\",\"command\":\"systemctl --user restart jarvis-ws jarvis-mcp 2>&1 | tail -5\"}","authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"id":"sh-n9","name":"JARVIS — Auto-Rest