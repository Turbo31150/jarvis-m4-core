{"updatedAt":"2026-03-19T16:52:28.543Z","createdAt":"2026-03-19T16:52:28.543Z","id":"etQx7GHxQ3YZ9PG4","name":"JARVIS — Disk Space Monitor","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":1}]}},"id":"dsk-t","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[250,300]},{"parameters":{"jsCode":"const{execSync}=require(\"child_process\");\nconst output=execSync(\"df -h / --output=pcent,size,used,avail | tail -1\",{encoding:\"utf-8\",timeout:10000});\nconst parts=output.trim().split(/\\s+/);\nconst usagePct=parseInt(parts[0].replace(\"%\",\"\"));\nconst dfFull=execSync(\"df -h / | tail -1\",{encoding:\"utf-8\",timeout:10000}).trim();\nreturn[{json:{usagePct,size:parts[1]||\"unknown\",used:parts[2]||\"unknown\",avail:parts[3]||\"unknown\",raw:dfFull,isWarning:usagePct>80,checkedAt:new Date().toISOString()}}];"},"id":"dsk-c","name":"Check Disk Usage","type":"n8n-nodes-base.code","typeVersion":2,"position":[470,300]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"dsk-c1","leftValue":"={{ $json.isWarning }}","rightValue":true,"operator":{"type":"boolean","operation":"equals","singleValue":true}}],"combinator":"and"},"options":{}},"id":"dsk-if","name":"IF Disk Over 80pct","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[690,300]},{"parameters":{"method":"POST","url":"http://127.0.0.1:9742/api/notify","sendBody":true,"bodyParameters":{"parameters":[{"name":"message","value":"=DISK WARNING: Root filesystem at {{ $json.usagePct }}% ({{ $json.used }} used / {{ $json.size }} total, {{ $json.avail }} free)"},{"name":"level","value":"warning"},{"name":"source","value":"n8n-disk-monitor"}]},"options":{}},"id":"dsk-n","name":"POST Notify Disk Warning","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[910,200]}],"connections":{"Schedule Trigger":{"main":[[{"node"