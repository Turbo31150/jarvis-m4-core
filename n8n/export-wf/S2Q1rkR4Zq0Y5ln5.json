{"updatedAt":"2026-07-16T15:14:38.000Z","createdAt":"2026-03-19T16:53:13.013Z","id":"S2Q1rkR4Zq0Y5ln5","name":"JARVIS — Workflow Self-Monitor","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":1}]}},"id":"s8","name":"Every Hour","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[200,300]},{"parameters":{"jsCode":"const {execSync} = require(\"child_process\");\ntry {\n  const key = execSync(\"cat /tmp/n8n_key.txt\").toString().trim();\n  const res = execSync(`curl -s http://127.0.0.1:5678/api/v1/workflows -H \"X-N8N-API-KEY: ${key}\"`).toString();\n  const data = JSON.parse(res);\n  const wfs = data.data || [];\n  const total = wfs.length;\n  const active = wfs.filter(w => w.active).length;\n  const inactive = wfs.filter(w => !w.active);\n  const deactivated = inactive.map(w => w.name).slice(0, 10);\n  return [{json: {total, active, inactiveCount: inactive.length, deactivated, hasDeactivated: inactive.length > 0}}];\n} catch(e) { return [{json: {error: e.message}}]; }"},"id":"c8","name":"Check n8n Workflows","type":"n8n-nodes-base.code","typeVersion":2,"position":[420,300]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"cond1","leftValue":"={{$json.hasDeactivated}}","rightValue":true,"operator":{"type":"boolean","operation":"equals"}}],"combinator":"and"}},"id":"if8","name":"IF Deactivated","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[640,300]},{"parameters":{"url":"http://127.0.0.1:3000/api/notify","method":"POST","sendBody":true,"bodyParameters":{"parameters":[{"name":"message","value":"=n8n Monitor: {{$json.inactiveCount}} workflows deactivated: {{$json.deactivated}}"},{"name":"source","value":"n8n-self-monitor"}]},"options":{}},"id":"p8","name":"Notify","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[860,200]}],"connections":{"Every Hour":{"main":[[{"node":"Chec