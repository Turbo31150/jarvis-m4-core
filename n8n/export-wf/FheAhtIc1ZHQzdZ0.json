{"updatedAt":"2026-07-16T01:03:11.000Z","createdAt":"2026-03-19T16:50:54.069Z","id":"FheAhtIc1ZHQzdZ0","name":"JARVIS — Trading Position Tracker","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":30}]}},"name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[250,300],"id":"a4000001-0001-0001-0001-000000000001"},{"parameters":{"url":"http://127.0.0.1:9742/api/trading/status","options":{"timeout":10000}},"name":"GET Trading Status","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[470,300],"id":"a4000001-0001-0001-0001-000000000002"},{"parameters":{"jsCode":"const data = $input.first().json;\nconst positions = data.positions || data.openPositions || data.trades || [];\nconst posList = Array.isArray(positions) ? positions : [];\nlet report = \"\";\nlet totalPnl = 0;\nif (posList.length > 0) {\n  report = `Open Positions (${posList.length}):\\n`;\n  posList.forEach((p, i) => {\n    const pnl = p.pnl || p.profit || p.unrealizedPnl || 0;\n    totalPnl += parseFloat(pnl) || 0;\n    report += `${i+1}. ${p.symbol || p.pair}: ${p.side || p.direction || \"?\"} | Entry: $${p.entryPrice || p.entry || \"?\"} | PnL: $${pnl}\\n`;\n  });\n  report += `\\nTotal PnL: $${totalPnl.toFixed(2)}`;\n} else {\n  report = \"No open positions.\";\n}\nconst hasPositions = posList.length > 0 ? \"true\" : \"false\";\nreturn [{json: {report, hasPositions, positionCount: posList.length, totalPnl}}];"},"name":"Extract Positions","type":"n8n-nodes-base.code","typeVersion":2,"position":[690,300],"id":"a4000001-0001-0001-0001-000000000003"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"c1","leftValue":"={{ $json.hasPositions }}","rightValue":"true","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},"name":"IF Positions Open","type":"n8n-nodes-base.if","typeVersion":2.