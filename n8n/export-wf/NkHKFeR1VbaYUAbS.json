{"updatedAt":"2026-06-25T12:31:13.706Z","createdAt":"2026-06-25T12:31:13.706Z","id":"NkHKFeR1VbaYUAbS","name":"JARVIS - RDV téléphone vers Google Calendar + Email","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"httpMethod":"POST","path":"jarvis-rdv","responseMode":"lastNode","options":{}},"id":"a1b2c3d4-0001-4000-8000-000000000001","name":"Webhook RDV","type":"n8n-nodes-base.webhook","typeVersion":2,"position":[240,300],"webhookId":"a1b2c3d4-0001-4000-8000-000000000001"},{"parameters":{"jsCode":"// Calcule l'ISO de fin = début + 30 min. datetime_iso peut être vide.\nconst body = $input.first().json.body || {};\nconst startIso = (body.datetime_iso || '').trim();\nlet endIso = '';\nif (startIso) {\n  const d = new Date(startIso);\n  if (!isNaN(d.getTime())) {\n    d.setMinutes(d.getMinutes() + 30);\n    // Format YYYY-MM-DDTHH:MM (local, sans secondes ni timezone)\n    const pad = (n) => String(n).padStart(2, '0');\n    endIso = `${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())}T${pad(d.getHours())}:${pad(d.getMinutes())}`;\n  }\n}\nreturn [{ json: { ...body, _start_iso: startIso, _end_iso: endIso } }];"},"id":"a1b2c3d4-0002-4000-8000-000000000002","name":"Calcul fin +30min","type":"n8n-nodes-base.code","typeVersion":2,"position":[460,300]},{"parameters":{"operation":"create","calendar":{"__rl":true,"value":"primary","mode":"list","cachedResultName":"primary"},"start":"={{ $json._start_iso }}","end":"={{ $json._end_iso }}","additionalFields":{"summary":"=RDV {{ $json.prenom }} {{ $json.nom }}","description":"=Demande: {{ $json.demande }}\nTel: {{ $json.numero }}\n\n{{ $json.historique }}"}},"id":"a1b2c3d4-0003-4000-8000-000000000003","name":"Google Calendar - Créer event","type":"n8n-nodes-base.googleCalendar","typeVersion":1,"position":[680,300],"credentials":{"googleCalendarOAuth2Api":{"id":"REPLACE_WITH_CREDENTIAL_ID","name":"Google Calendar account"}}},{"parameters":{"operation":"send","sendTo":"franck@example.com","subj