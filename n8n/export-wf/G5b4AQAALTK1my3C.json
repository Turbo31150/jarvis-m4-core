{"updatedAt":"2026-03-19T16:53:05.516Z","createdAt":"2026-03-19T16:53:05.516Z","id":"G5b4AQAALTK1my3C","name":"JARVIS — ZRAM & Memory Monitor","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":30}]}},"id":"mem-t","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[250,300]},{"parameters":{"jsCode":"const{execSync}=require(\"child_process\");\nconst freeOutput=execSync(\"free -m\",{encoding:\"utf-8\",timeout:10000});\nconst lines=freeOutput.trim().split(\"\\n\");\nconst memLine=lines[1].split(/\\s+/);\nconst totalRAM=parseInt(memLine[1]);\nconst usedRAM=parseInt(memLine[2]);\nconst availRAM=parseInt(memLine[6]);\nconst ramPct=Math.round((usedRAM/totalRAM)*100);\nlet swapInfo={};\ntry{const swapOutput=execSync(\"swapon --show --noheadings --bytes 2>/dev/null\",{encoding:\"utf-8\",timeout:10000});const swapLines=swapOutput.trim().split(\"\\n\").filter(l=>l.trim());swapInfo.devices=swapLines.map(l=>{const p=l.split(/\\s+/);return{name:p[0],type:p[1],size:p[2],used:p[3]};});swapInfo.zramActive=swapLines.some(l=>l.includes(\"zram\"));}catch(e){swapInfo={devices:[],zramActive:false};}\nconst swapLine=lines.find(l=>l.startsWith(\"Swap\"));\nlet swapTotal=0,swapUsed=0;\nif(swapLine){const sp=swapLine.split(/\\s+/);swapTotal=parseInt(sp[1]);swapUsed=parseInt(sp[2]);}\nreturn[{json:{totalRAM,usedRAM,availRAM,ramPct,swapTotal,swapUsed,swap:swapInfo,isWarning:ramPct>90,checkedAt:new Date().toISOString()}}];"},"id":"mem-c","name":"Check Memory and ZRAM","type":"n8n-nodes-base.code","typeVersion":2,"position":[470,300]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"mem-c1","leftValue":"={{ $json.isWarning }}","rightValue":true,"operator":{"type":"boolean","operation":"equals","singleValue":true}}],"combinator":"and"},"options":{}},"id":"mem-if","name":"IF RAM Over 90pct","type":"