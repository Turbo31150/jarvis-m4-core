{"updatedAt":"2026-03-19T16:51:48.198Z","createdAt":"2026-03-19T16:51:48.198Z","id":"U5rTJtUhWxrOvhtl","name":"JARVIS — Docker Container Manager","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":30}]}},"id":"dc-trigger","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[250,300]},{"parameters":{"url":"http://127.0.0.1:9742/health/full","options":{}},"id":"dc-health","name":"GET Health Full","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[470,300]},{"parameters":{"jsCode":"const health = $input.all()[0].json;\nconst docker = health.components ? health.components.docker : (health.docker || {});\nconst containers = docker.containers || docker.details || [];\nlet downContainers = [];\nif (Array.isArray(containers)) {\n  for (const c of containers) {\n    const state = (c.state || c.status || \"\").toLowerCase();\n    if (state !== \"running\" && state !== \"healthy\") {\n      downContainers.push({ name: c.name || c.Names || \"unknown\", state });\n    }\n  }\n}\nreturn [{ json: { downContainers, hasDown: downContainers.length > 0, checkedAt: new Date().toISOString() } }];"},"id":"dc-code","name":"Extract Docker Status","type":"n8n-nodes-base.code","typeVersion":2,"position":[690,300]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"dc-c1","leftValue":"={{ $json.hasDown }}","rightValue":true,"operator":{"type":"boolean","operation":"equals","singleValue":true}}],"combinator":"and"},"options":{}},"id":"dc-if","name":"IF Container Down","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[910,300]},{"parameters":{"method":"POST","url":"http://127.0.0.1:9742/api/notify","sendBody":true,"bodyParameters":{"parameters":[{"name":"message","value":"=DOCKER ALERT: Containers down: {{ $json.downContainers.map(c => c.name).join(\", \") }}"},{"name":"level","value":"critical"},{"name":"source","value":"n8n-docker-manager"}]},"options":{}},"id":"dc-notify","name":"POST Notify","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1130,200]},{"parameters":{"jsCode":"const down = $input.all()[0].json.downContainers || [];\nconst commands = down.map(c => `docker restart ${c.name}`);\nreturn [{ json: { restartCommands: commands, message: `Restart commands generated for ${down.length} container(s)` } }];"},"id":"dc-restart","name":"Generate Restart Commands","type":"n8n-nodes-base.code","typeVersion":2,"position":[1350,200]}],"connections":{"Schedule Trigger":{"main":[[{"node":"GET Health Full","type":"main","index":0}]]},"GET Health Full":{"main":[[{"node":"Extract Docker Status","type":"main","index":0}]]},"Extract Docker Status":{"main":[[{"node":"IF Container Down","type":"main","index":0}]]},"IF Container Down":{"main":[[{"node":"POST Notify","type":"main","index":0}],[]]},"POST Notify":{"main":[[{"node":"Generate Restart Commands","type":"main","index":0}]]}},"settings":{"executionOrder":"v1","callerPolicy":"workflowsFromSameOwner","availableInMCP":false},"staticData":{"node:Schedule Trigger":{"recurrenceRules":[]}},"meta":null,"nodeGroups":[],"pinData":null,"versionId":"af1449f5-8a17-4314-b46f-1b6183740f61","activeVersionId":"af1449f5-8a17-4314-b46f-1b6183740f61","versionCounter":1881,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-03-19T16:51:48.199Z","createdAt":"2026-03-19T16:51:48.199Z","role":"workflow:owner","workflowId":"U5rTJtUhWxrOvhtl","projectId":"SvBenKSzeDz1VaKl","project":{"updatedAt":"2026-06-25T12:29:44.000Z","createdAt":"2026-03-12T03:56:07.666Z","id":"SvBenKSzeDz1VaKl","name":"Franck Delmas <franckdelmas00@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"5e391653-182d-4fe7-bede-1290b513899f"}}],"versionMetadata":{"name":null,"description":null}}