{"updatedAt":"2026-07-16T01:03:06.000Z","createdAt":"2026-03-19T16:50:27.321Z","id":"dgqAEIhDWhkIcTrc","name":"JARVIS — Trading Consensus Engine","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"hours","hoursInterval":2}]}},"name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[250,300],"id":"a2000001-0001-0001-0001-000000000001"},{"parameters":{"url":"http://127.0.0.1:9742/api/orchestrator/nodes","options":{"timeout":10000}},"name":"GET Orchestrator Nodes","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[470,300],"id":"a2000001-0001-0001-0001-000000000002"},{"parameters":{"jsCode":"const nodes = $input.first().json;\nconst nodeList = Array.isArray(nodes) ? nodes : (nodes.nodes || nodes.data || []);\nconst activeModels = nodeList.filter(n => n.status === \"online\" || n.status === \"active\" || n.connected);\nconst modelNames = activeModels.map(n => n.name || n.model || n.id).join(\", \");\nreturn [{json: {activeModels: modelNames, activeCount: activeModels.length, totalNodes: nodeList.length}}];"},"name":"Check Active Models","type":"n8n-nodes-base.code","typeVersion":2,"position":[690,300],"id":"a2000001-0001-0001-0001-000000000003"},{"parameters":{"url":"http://127.0.0.1:9742/api/trading/status","options":{"timeout":10000}},"name":"GET Trading Status","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[910,300],"id":"a2000001-0001-0001-0001-000000000004"},{"parameters":{"jsCode":"const models = $(\"Check Active Models\").first().json;\nconst trading = $input.first().json;\nconst status = trading.status || trading.state || \"unknown\";\nconst summary = `Trading Consensus:\\n- Active AI models: ${models.activeCount} (${models.activeModels})\\n- Trading status: ${status}\\n- Scanner: ${trading.scanner || \"N/A\"}\\n- Open positions: ${trading.positions?.length || trading.openPositions || 0}`;\nreturn [{json: {summary, consensus: models.ac