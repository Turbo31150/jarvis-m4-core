{"updatedAt":"2026-07-16T01:03:09.000Z","createdAt":"2026-03-19T16:50:41.657Z","id":"2n7dJiqtNm8cIXZh","name":"JARVIS — Crypto Alert (BTC/ETH/SOL)","description":null,"active":false,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":15}]}},"name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[250,300],"id":"a3000001-0001-0001-0001-000000000001"},{"parameters":{"url":"https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,dogecoin,ripple&vs_currencies=usd,eur&include_24hr_change=true","options":{"timeout":15000}},"name":"GET Crypto Prices","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[470,300],"id":"a3000001-0001-0001-0001-000000000002"},{"parameters":{"jsCode":"const data = $input.first().json;\nconst coins = {bitcoin: \"BTC\", ethereum: \"ETH\", solana: \"SOL\", dogecoin: \"DOGE\", ripple: \"XRP\"};\nconst alerts = [];\nlet report = \"Crypto Price Check:\\n\";\nfor (const [id, symbol] of Object.entries(coins)) {\n  const c = data[id];\n  if (!c) continue;\n  const change = c.usd_24h_change || 0;\n  const line = `${symbol}: $${c.usd} / €${c.eur} (${change.toFixed(2)}% 24h)`;\n  report += `- ${line}\\n`;\n  if (Math.abs(change) > 5) {\n    alerts.push(`ALERT ${symbol}: ${change > 0 ? \"+\" : \"\"}${change.toFixed(2)}% ($${c.usd})`);\n  }\n}\nconst hasAlert = alerts.length > 0 ? \"true\" : \"false\";\nconst alertMsg = alerts.length > 0 ? alerts.join(\"\\n\") : \"No significant moves.\";\nreturn [{json: {report, alertMsg, hasAlert}}];"},"name":"Check 5% Change","type":"n8n-nodes-base.code","typeVersion":2,"position":[690,300],"id":"a3000001-0001-0001-0001-000000000003"},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"loose"},"conditions":[{"id":"c1","leftValue":"={{ $json.hasAlert }}","rightValue":"true","operator":{"type":"string","operation":"equals"}}],"combinator":"and"}},"name":"IF Alert","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[910,300],"id":"a3000001-0001-0001-0001-000000000004"},{"parameters":{"method":"POST","url":"http://127.0.0.1:9742/api/notify?title=Crypto+Price+Alert&level=warning","options":{"timeout":10000},"sendBody":true,"bodyParameters":{"parameters":[{"name":"message","value":"={{ $json.alertMsg + \"\\n\\n\" + $json.report }}"}]}},"name":"Notify Alert","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[1130,200],"id":"a3000001-0001-0001-0001-000000000005"}],"connections":{"Schedule Trigger":{"main":[[{"node":"GET Crypto Prices","type":"main","index":0}]]},"GET Crypto Prices":{"main":[[{"node":"Check 5% Change","type":"main","index":0}]]},"Check 5% Change":{"main":[[{"node":"IF Alert","type":"main","index":0}]]},"IF Alert":{"main":[[{"node":"Notify Alert","type":"main","index":0}],[]]}},"settings":{"executionOrder":"v1","callerPolicy":"workflowsFromSameOwner","availableInMCP":false},"staticData":{"node:Schedule Trigger":{"recurrenceRules":[]}},"meta":null,"nodeGroups":[],"pinData":null,"versionId":"fbe760c3-3385-4418-83b8-a8d9ba78c583","activeVersionId":null,"versionCounter":1883,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-03-19T16:50:41.659Z","createdAt":"2026-03-19T16:50:41.659Z","role":"workflow:owner","workflowId":"2n7dJiqtNm8cIXZh","projectId":"SvBenKSzeDz1VaKl","project":{"updatedAt":"2026-06-25T12:29:44.000Z","createdAt":"2026-03-12T03:56:07.666Z","id":"SvBenKSzeDz1VaKl","name":"Franck Delmas <franckdelmas00@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"5e391653-182d-4fe7-bede-1290b513899f"}}],"versionMetadata":{"name":null,"description":null}}