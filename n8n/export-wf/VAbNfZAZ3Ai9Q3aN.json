{"updatedAt":"2026-06-25T20:37:42.000Z","createdAt":"2026-03-19T16:52:19.574Z","id":"VAbNfZAZ3Ai9Q3aN","name":"JARVIS — Systemd Service Monitor","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"minutes","minutesInterval":15}]}},"id":"sys-t","name":"Schedule Trigger","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[250,300]},{"parameters":{"jsCode":"const{execSync}=require(\"child_process\");\nlet output;\ntry{output=execSync(\"systemctl --user list-units jarvis-* --no-pager --plain 2>/dev/null || systemctl list-units jarvis-* --no-pager --plain 2>/dev/null\",{encoding:\"utf-8\",timeout:15000});}catch(e){output=e.stdout||\"\";}\nconst lines=output.split(\"\\n\").filter(l=>l.trim()&&!l.startsWith(\"UNIT\")&&!l.includes(\"listed\")&&!l.includes(\"To show\"));\nconst services=[];const failed=[];\nfor(const line of lines){const parts=line.trim().split(/\\s+/);if(parts.length>=4){const svc={unit:parts[0],load:parts[1],active:parts[2],sub:parts[3]};services.push(svc);if(svc.active===\"failed\"||svc.sub===\"failed\"){failed.push(svc);}}}\nreturn[{json:{services,failed,hasFailed:failed.length>0,checkedAt:new Date().toISOString()}}];"},"id":"sys-c","name":"Check Systemd Units","type":"n8n-nodes-base.code","typeVersion":2,"position":[470,300]},{"parameters":{"conditions":{"options":{"caseSensitive":true,"leftValue":"","typeValidation":"strict"},"conditions":[{"id":"sys-c1","leftValue":"={{ $json.hasFailed }}","rightValue":true,"operator":{"type":"boolean","operation":"equals","singleValue":true}}],"combinator":"and"},"options":{}},"id":"sys-if","name":"IF Any Failed","type":"n8n-nodes-base.if","typeVersion":2.2,"position":[690,300]},{"parameters":{"method":"POST","url":"http://127.0.0.1:9742/api/notify","sendBody":true,"bodyParameters":{"parameters":[{"name":"message","value":"=SYSTEMD ALERT: Failed services: {{ $json.failed.map(s => s.unit).join(\", \") }}"},{"name":"level","value":"critical"},{"name":"source","value":"n8n-systemd-monitor"}]},"options":{}},"id":"sys-n","name":"POST Notify Failed","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[910,200]}],"connections":{"Schedule Trigger":{"main":[[{"node":"Check Systemd Units","type":"main","index":0}]]},"Check Systemd Units":{"main":[[{"node":"IF Any Failed","type":"main","index":0}]]},"IF Any Failed":{"main":[[{"node":"POST Notify Failed","type":"main","index":0}],[]]}},"settings":{"executionOrder":"v1","callerPolicy":"workflowsFromSameOwner","availableInMCP":false},"staticData":{"node:Schedule Trigger":{"recurrenceRules":[]}},"meta":null,"nodeGroups":[],"pinData":null,"versionId":"673f2d18-4087-4b06-93cd-b49946b7776c","activeVersionId":"673f2d18-4087-4b06-93cd-b49946b7776c","versionCounter":1881,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-03-19T16:52:19.576Z","createdAt":"2026-03-19T16:52:19.576Z","role":"workflow:owner","workflowId":"VAbNfZAZ3Ai9Q3aN","projectId":"SvBenKSzeDz1VaKl","project":{"updatedAt":"2026-06-25T12:29:44.000Z","createdAt":"2026-03-12T03:56:07.666Z","id":"SvBenKSzeDz1VaKl","name":"Franck Delmas <franckdelmas00@gmail.com>","type":"personal","icon":null,"description":null,"customTelemetryTags":[],"creatorId":"5e391653-182d-4fe7-bede-1290b513899f"}}],"versionMetadata":{"name":null,"description":null}}