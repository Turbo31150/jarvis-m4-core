{"updatedAt":"2026-03-16T23:03:28.980Z","createdAt":"2026-03-16T22:54:05.272Z","id":"NoQhl6t4zdzqIEQ2","name":"JARVIS — Daily Briefing & Telegram Alert","description":null,"active":true,"isArchived":false,"nodes":[{"parameters":{"rule":{"interval":[{"field":"cronExpression","expression":"0 8 * * *"}]}},"id":"a1b2c3d4-0001","name":"Tous les matins à 8h","type":"n8n-nodes-base.scheduleTrigger","typeVersion":1.2,"position":[200,320]},{"parameters":{"url":"https://hacker-news.firebaseio.com/v0/topstories.json","options":{}},"id":"a1b2c3d4-0002","name":"HackerNews — Top Stories IDs","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[440,180]},{"parameters":{"url":"=https://hacker-news.firebaseio.com/v0/item/{{ $json[0] }}.json","options":{}},"id":"a1b2c3d4-0003","name":"HN — Fetch Article #1","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[680,100]},{"parameters":{"url":"https://api.github.com/search/repositories?q=topic:ai-agent+topic:llm&sort=stars&order=desc&per_page=3","options":{"headers":{"values":[{"name":"Accept","value":"application/vnd.github.v3+json"}]}}},"id":"a1b2c3d4-0004","name":"GitHub — Trending AI Repos","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[440,320]},{"parameters":{"url":"https://api.coingecko.com/api/v3/simple/price?ids=bitcoin,ethereum,solana,sui&vs_currencies=usd&include_24hr_change=true","options":{}},"id":"a1b2c3d4-0005","name":"Crypto — BTC ETH SOL SUI Prix","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[440,460]},{"parameters":{"url":"http://127.0.0.1:9742/health","options":{}},"id":"a1b2c3d4-0006","name":"JARVIS — Cluster Health Check","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[440,600]},{"parameters":{"jsCode":"// Assemble le briefing quotidien JARVIS\nconst github = $('GitHub — Trending AI Repos').first().json;\nconst crypto = $('Crypto — BTC ETH SOL SUI Prix').first().json;\nconst clusterHealth = $('JARVIS — Cluster Health Check').first().json;\n\nconst now = new Date();\nconst dateStr = now.toLocaleDateString('fr-FR', { weekday: 'long', day: 'numeric', month: 'long', year: 'numeric' });\nconst timeStr = now.toLocaleTimeString('fr-FR', { hour: '2-digit', minute: '2-digit' });\n\n// GitHub repos\nlet ghSection = '🔥 *GitHub Trending IA:*\\n';\nif (github?.items?.length) {\n  ghSection += github.items.map(r => `  • [${r.full_name}](${r.html_url}) ⭐${r.stargazers_count}`).join('\\n');\n} else {\n  ghSection += '  (données indisponibles)';\n}\n\n// Crypto\nlet cryptoSection = '💰 *Crypto Snapshot:*\\n';\nconst pairs = ['bitcoin','ethereum','solana','sui'];\nconst symbols = { bitcoin:'₿ BTC', ethereum:'Ξ ETH', solana:'◎ SOL', sui:'🔵 SUI' };\nif (crypto) {\n  cryptoSection += pairs.map(id => {\n    const d = crypto[id];\n    if (!d) return null;\n    const change = d.usd_24h_change?.toFixed(2);\n    const arrow = change >= 0 ? '📈' : '📉';\n    return `  ${symbols[id]}: $${d.usd?.toLocaleString()} ${arrow} ${change}%`;\n  }).filter(Boolean).join('\\n');\n} else {\n  cryptoSection += '  (données indisponibles)';\n}\n\n// Cluster status\nlet clusterSection = '🖥️ *JARVIS Cluster M1:*\\n';\nif (clusterHealth && !clusterHealth.error) {\n  clusterSection += `  ✅ WebSocket :9742 UP\\n  🤖 JARVIS v12.6 — La Creatrice opérationnelle`;\n} else {\n  clusterSection += `  ⚠️ Cluster non joignable depuis n8n`;\n}\n\nconst message = `🤖 *JARVIS — Briefing du ${dateStr}*\n⏰ ${timeStr}\n\n${ghSection}\n\n${cryptoSection}\n\n${clusterSection}\n\n━━━━━━━━━━━━━━━━\n_Généré par n8n × JARVIS v12.6_`;\n\nreturn [{ json: { message, date: dateStr, time: timeStr } }];"},"id":"a1b2c3d4-0007","name":"Compose — Briefing JARVIS","type":"n8n-nodes-base.code","typeVersion":2,"position":[720,400]},{"parameters":{"url":"http://127.0.0.1:8080/mcp","method":"POST","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"tool\": \"speak\",\n  \"text\": \"Briefing du matin prêt. {{ $json.message.substring(0, 100) }}\"\n}","options":{"headers":{"values":[{"name":"Content-Type","value":"application/json"}]}},"authentication":"genericCredentialType","genericAuthType":"httpHeaderAuth"},"id":"a1b2c3d4-0008","name":"JARVIS — MCP Speak Briefing","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[960,320],"credentials":{"httpHeaderAuth":{"id":"fAsADvvR1C8MIjSp","name":"JARVIS MCP Bearer"}}},{"parameters":{"url":"=http://127.0.0.1:9742/api/message","method":"POST","sendBody":true,"specifyBody":"json","jsonBody":"={\n  \"prompt\": \"{{ $json.message }}\",\n  \"pattern\": \"simple\",\n  \"source\": \"n8n-daily-briefing\"\n}","options":{}},"id":"a1b2c3d4-0009","name":"JARVIS — Envoyer au Dispatcher","type":"n8n-nodes-base.httpRequest","typeVersion":4.2,"position":[960,480]}],"connections":{"Tous les matins à 8h":{"main":[[{"node":"HackerNews — Top Stories IDs","type":"main","index":0},{"node":"GitHub — Trending AI Repos","type":"main","index":0},{"node":"Crypto — BTC ETH SOL SUI Prix","type":"main","index":0},{"node":"JARVIS — Cluster Health Check","type":"main","index":0}]]},"HackerNews — Top Stories IDs":{"main":[[{"node":"HN — Fetch Article #1","type":"main","index":0}]]},"GitHub — Trending AI Repos":{"main":[[{"node":"Compose — Briefing JARVIS","type":"main","index":0}]]},"Crypto — BTC ETH SOL SUI Prix":{"main":[[{"node":"Compose — Briefing JARVIS","type":"main","index":0}]]},"JARVIS — Cluster Health Check":{"main":[[{"node":"Compose — Briefing JARVIS","type":"main","index":0}]]},"Compose — Briefing JARVIS":{"main":[[{"node":"JARVIS — MCP Speak Briefing","type":"main","index":0},{"node":"JARVIS — Envoyer au Dispatcher","type":"main","index":0}]]}},"settings":{"executionOrder":"v1"},"staticData":{"node:Tous les matins à 8h":{"recurrenceRules":[]}},"meta":null,"nodeGroups":[],"pinData":null,"versionId":"33dad3b9-b693-43b7-aedd-76b99a99fabc","activeVersionId":"33dad3b9-b693-43b7-aedd-76b99a99fabc","versionCounter":1898,"triggerCount":1,"sourceWorkflowId":null,"tags":[],"shared":[{"updatedAt":"2026-03-16T22: