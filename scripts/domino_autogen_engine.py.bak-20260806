#!/usr/bin/env python3
"""
DOMINO AUTO-GEN ENGINE — Moteur autonome de génération infinie de séries bash domino.
Génère, compile, valide et push GitHub en boucle perpétuelle.
Turbo JARVIS OS — Ne s'arrête JAMAIS.
"""

import os
import subprocess
import sqlite3
import time
import random
import sys
from datetime import datetime

SERIES_DIR = "/home/turbo/labo/bibliotheque/series"
DB = "/home/turbo/jarvis/jarvis_master.db"
LOG = "/tmp/domino_autogen.log"
REPO = "/home/turbo/labo"

os.makedirs(SERIES_DIR, exist_ok=True)


def log(msg):
    ts = datetime.now().strftime("%H:%M:%S")
    line = f"[{ts}] {msg}"
    print(line, flush=True)
    with open(LOG, "a") as f:
        f.write(line + "\n")


def existing_series():
    return {
        os.path.basename(f)[:-3] for f in os.listdir(SERIES_DIR) if f.endswith(".sh")
    }


def db_register(name, verdict, path):
    try:
        # WAL : un seul écrivain à la fois sur une base très sollicitée,
        # il faut attendre au lieu d'échouer sur "database is locked".
        conn = sqlite3.connect(DB, timeout=120)
        conn.execute("PRAGMA busy_timeout=120000")
        conn.execute(
            "INSERT OR REPLACE INTO domino_chains(serie,verdict,steps,ts) VALUES(?,?,?,datetime('now'))",
            (name, verdict, path),
        )
        conn.commit()
        conn.close()
    except Exception as e:
        log(f"  ⚠️ DB err: {e}")


def validate(path):
    r = subprocess.run(["bash", "--norc", "-n", path], capture_output=True)
    return "valide-syntaxe-ok" if r.returncode == 0 else "syntaxe-error"


def git_push(batch_names):
    """Commit + push des séries générées.

    Injection de commande corrigée : le message était interpolé dans un
    `bash -c "... git commit -m '{msg}' ..."`. Or `msg` contient des noms de
    séries produits en amont — une seule apostrophe dans un nom fermait la
    chaîne et le reste passait au shell. On n'assemble donc plus de ligne de
    commande : chaque appel est une liste argv exécutée sans shell, où le
    message ne peut être qu'un argument, jamais de la syntaxe.
    """
    apercu = ", ".join(batch_names[:4]) + ("..." if len(batch_names) > 4 else "")
    msg = f"feat(domino): +{len(batch_names)} séries auto [{apercu}]"
    try:
        for argv in (
            ["git", "-C", REPO, "add", "bibliotheque/series/"],
            ["git", "-C", REPO, "commit", "--no-verify", "-m", msg, "--quiet"],
            ["git", "-C", REPO, "push", "--quiet"],
        ):
            r = subprocess.run(argv, capture_output=True, text=True, timeout=180)
            if r.returncode != 0:
                # « rien à commiter » est un cas normal, pas une panne.
                log(f"  ⚠️ {argv[3]}: {(r.stderr or r.stdout).strip()[:200]}")
                return
        with open(LOG, "a") as fh:
            fh.write("✅ pushed\n")
    except (OSError, subprocess.SubprocessError) as e:
        log(f"  ⚠️ git push err: {e}")


def make_serie(name, description, body):
    """Crée un fichier série bash et le valide."""
    path = f"{SERIES_DIR}/{name}.sh"
    if os.path.exists(path):
        return None, "exists"
    content = f"""#!/usr/bin/env bash
# DOMINO {name.upper()} — {description}
# Généré automatiquement par JARVIS DOMINO AUTO-GEN ENGINE
# Usage: bash {name}.sh [args]
set -uo pipefail
JARVIS="$HOME/jarvis"; SCR="$JARVIS/scripts"; LM="$JARVIS/scripts/lm-ask.sh"
{body}
"""
    with open(path, "w") as f:
        f.write(content)
    os.chmod(path, 0o755)
    verdict = validate(path)
    db_register(name, verdict, path)
    return path, verdict


