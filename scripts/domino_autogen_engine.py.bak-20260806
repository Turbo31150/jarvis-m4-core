# ════════════════════════════════════════════════════════════════
#  MOTEUR AUTONOME — BOUCLE INFINIE
# ════════════════════════════════════════════════════════════════
def run_autogen_cycle():
    existing = existing_series()
    pending = [(n, d, b) for n, d, b in SERIES_CATALOG if n not in existing]
    random.shuffle(pending)

    if not pending:
        log(
            f"✅ Toutes les {len(SERIES_CATALOG)} séries du catalogue sont déjà créées."
        )
        return 0

    log(f"🎯 {len(pending)} séries à créer sur {len(SERIES_CATALOG)} dans le catalogue")
    created = []
    errors = []

    for name, desc, body in pending:
        path, verdict = make_serie(name, desc, body)
        if verdict == "exists":
            continue
        elif verdict == "valide-syntaxe-ok":
            log(f"  ✅ {name}.sh")
            created.append(name)
        else:
            log(f"  ⚠️  {name}.sh [{verdict}]")
            errors.append(name)

    if created:
        log(f"📤 Push GitHub: {len(created)} nouvelles séries...")
        git_push(created)

    log(f"═══ Cycle terminé: +{len(created)} créées | {len(errors)} erreurs ═══")
    total = len(list(os.listdir(SERIES_DIR)))
    log(f"📊 TOTAL SÉRIES SUR DISQUE: {total}")
    return len(created)


if __name__ == "__main__":
    once = "--once" in sys.argv
    log("🚀 DOMINO AUTO-GEN ENGINE DÉMARRÉ")
    log(
        f"   Catalogue: {len(SERIES_CATALOG)} recettes | Mode: {'once' if once else 'boucle infinie'}"
    )
    cycle = 0
    while True:
        cycle += 1
        log(f"\n══════ CYCLE #{cycle} ══════")
        n = run_autogen_cycle()
        if once:
            break
        delay = 300 if n > 0 else 600  # 5min si créations, 10min sinon
        log(f"⏳ Pause {delay // 60}min avant prochain cycle...")
        time.sleep(delay)
