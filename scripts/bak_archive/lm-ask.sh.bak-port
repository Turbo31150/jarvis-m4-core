#!/bin/bash
# lm-ask.sh — dual-model sync M1+M2+OL1, multi-slots parallèles par défaut
# Usage : lm-ask.sh "question" [--reason] [--big] [--model ID] [--max N] [--seq]
# Mode : appels parallèles (M1×2 + M2×2 + OL1 si fast-lane), premier non-vide gagne
# --reason  → deepseek-r1 sur M1+M2
# --big     → qwen3.5-35b sur M2
# --seq     → séquentiel M1→M2→OL1 (fallback)
# Env:
#   LM_NO_OL1=1      → désactive fast-lane OL1
#   LM_FORCE_M1=1    → ignore load-shedding M1
#   LM_OL1_KEEP=30m  → keep_alive Ollama (def 30m)

set -e

MODEL_FAST="qwen/qwen3.5-9b"
MODEL_R1="deepseek/deepseek-r1-0528-qwen3-8b"
MODEL_BIG="qwen/qwen3.5-35b-a3b"
MODEL_OL1="gemma3:4b"
OL1_KEEP="${LM_OL1_KEEP:-30m}"
MAX=3000
MODE="dual"   # dual | seq | single
SYS="Tu es un assistant concis. Réponds directement en français, sans préambule."

MODELS_M1=("$MODEL_FAST" "$MODEL_R1")
MODELS_M2=("$MODEL_FAST" "$MODEL_R1")

# Détection flags pour décider fast-lane OL1
USE_BIG=0; USE_REASON=0
for a in "$@"; do
  case "$a" in
    --big)    USE_BIG=1 ;;
    --reason) USE_REASON=1 ;;
  esac
done

while [[ "$1" == --* ]]; do
  case "$1" in
    --model)  MODELS_M1=("$2"); MODELS_M2=("$2"); shift 2 ;;
    --max)    MAX="$2"; shift 2 ;;
    --reason) MODELS_M1=("$MODEL_R1"); MODELS_M2=("$MODEL_R1"); shift ;;
    --big)    MODELS_M1=("$MODEL_FAST"); MODELS_M2=("$MODEL_BIG"); shift ;;
    --fast)   MODELS_M1=("$MODEL_FAST"); MODELS_M2=("$MODEL_FAST"); shift ;;
    --seq)    MODE="seq"; shift ;;
    *) shift ;;
  esac
done

PROMPT="$*"
[[ -t 0 ]] || PROMPT="$(cat)
$PROMPT"
[[ -z "$PROMPT" ]] && { echo "Usage: lm-ask.sh \"question\"" >&2; exit 1; }

# Fast-lane OL1 : prompt court (<500c) ET pas --big/--reason ET LM_NO_OL1 != 1
PROMPT_LEN=${#PROMPT}
OL1_FAST_LANE=0
if [[ "${LM_NO_OL1:-0}" != "1" && $USE_BIG -eq 0 && $USE_REASON -eq 0 && $PROMPT_LEN -lt 500 ]]; then
  OL1_FAST_LANE=1
fi

M1="http://192.168.1.85:11234"
M2="http://192.168.1.26:1234"
M3_OLLAMA="http://192.168.1.113:11434"

call_model() {
  local host="$1" model="$2"
  local payload
  payload="$(jq -nc --arg m "$model" --arg s "$SYS" --arg p "$PROMPT" --argjson n "$MAX" \
    '{model:$m,messages:[{role:"system",content:$s},{role:"user",content:$p}],max_tokens:$n,temperature:0.2,enable_thinking:false}')"
  curl -s -m 120 "$host/v1/chat/completions" \
    -H "Content-Type: application/json" \
    -d "$payload" \
    | jq -r '(.choices[0].message.content // .choices[0].message.reasoning_content) // empty' 2>/dev/null
}

call_ollama() {
  local base="${1:-http://127.0.0.1:11434}" model="${2:-gemma3:4b}" keep="${3:-$OL1_KEEP}"
  curl -s -m 60 "$base/api/generate" \
    -d "$(jq -nc --arg m "$model" --arg p "$SYS\n\n$PROMPT" --arg k "$keep" \
        '{model:$m,prompt:$p,stream:false,keep_alive:$k}')" \
    | jq -r '.response // empty' 2>/dev/null
}

# Vérif connectivité (1s timeout)
M1_UP=0; M2_UP=0; OL1_UP=0; OL3_UP=0
curl -s -m 1 "$M1/v1/models" 2>/dev/null | grep -q '"id"' && M1_UP=1
curl -s -m 1 "$M2/v1/models" 2>/dev/null | grep -q '"id"' && M2_UP=1
curl -s -m 1 http://127.0.0.1:11434/api/tags >/dev/null 2>&1 && OL1_UP=1
curl -s -m 1 "$M3_OLLAMA/api/tags" >/dev/null 2>&1 && OL3_UP=1

# Load-shedding M1: si load1 > 8 (cores=16), bascule tout vers M2/OL1 pour distribuer
LOAD1=$(awk '{print int($1)}' /proc/loadavg 2>/dev/null || echo 0)
if [[ "${LM_FORCE_M1:-0}" != "1" && $LOAD1 -gt 8 && ( $M2_UP -eq 1 || $OL1_UP -eq 1 ) ]]; then
  M1_UP=0
  # Force OL1 dans la course si dispo (load-shedding)
  [[ $OL1_UP -eq 1 && "${LM_NO_OL1:-0}" != "1" ]] && OL1_FAST_LANE=1
  echo "[lm-ask] load=$LOAD1 → skip M1, route → M2/OL1" >&2
fi

[[ $M1_UP -eq 0 && $M2_UP -eq 0 && $OL1_UP -eq 0 && $OL3_UP -eq 0 ]] && { echo "✘ Aucun backend dispo" >&2; exit 2; }

if [[ "$MODE" == "dual" ]]; then
  # === MODE DUAL : M1×2 + M2×2 (+ OL1 fast-lane) en parallèle — premier gagne ===
  TMPF="$(mktemp)"
  PIDS=()

  [[ $M1_UP -eq 1 ]] && for m in "${MODELS_M1[@]}"; do
    ( R="$(call_model "$M1" "$m")"; [[ -n "$R" ]] && echo "$R" > "$TMPF" ) &
    PIDS+=($!)
  done

  [[ $M2_UP -eq 1 ]] && for m in "${MODELS_M2[@]}"; do
    ( R="$(call_model "$M2" "$m")"; [[ -n "$R" ]] && echo "$R" > "$TMPF" ) &
    PIDS+=($!)
  done

  # Fast-lane OL1 : ajouté à la course pour prompts courts
  if [[ $OL1_UP -eq 1 && $OL1_FAST_LANE -eq 1 ]]; then
    ( R="$(call_ollama "http://127.0.0.1:11434" "$MODEL_OL1" "$OL1_KEEP")"; [[ -n "$R" ]] && echo "$R" > "$TMPF" ) &
    PIDS+=($!)
  fi

  # OL1 + OL3 (M3 Ollama) si aucun racer démarré (fallback ultime)
  [[ $OL1_UP -eq 1 && ${#PIDS[@]} -eq 0 ]] && {
    ( R="$(call_ollama "http://127.0.0.1:11434" "$MODEL_OL1" "$OL1_KEEP")"; [[ -n "$R" ]] && echo "$R" > "$TMPF" ) &
    PIDS+=($!)
  }
  [[ $OL3_UP -eq 1 && ${#PIDS[@]} -eq 0 ]] && {
    ( R="$(call_ollama "$M3_OLLAMA" "deepseek-r1:7b" "$OL1_KEEP")"; [[ -n "$R" ]] && echo "$R" > "$TMPF" ) &
    PIDS+=($!)
  }

  # Poll max 120s — premier résultat non-vide gagne
  for i in $(seq 1 240); do
    sleep 0.5
    if [[ -s "$TMPF" ]]; then
      cat "$TMPF"; rm -f "$TMPF"
      kill "${PIDS[@]}" 2>/dev/null
      exit 0
    fi
  done
  rm -f "$TMPF"; kill "${PIDS[@]}" 2>/dev/null
  echo "✘ Timeout dual-mode" >&2; exit 2

else
  # === MODE SEQ : OL1 (si fast-lane) → M1 → M2 → OL3 → OL1 fallback ===
  if [[ $OL1_UP -eq 1 && $OL1_FAST_LANE -eq 1 ]]; then
    R="$(call_ollama "http://127.0.0.1:11434" "$MODEL_OL1" "$OL1_KEEP")"
    [[ -n "$R" ]] && echo "$R" && exit 0
  fi
  for m in "${MODELS_M1[@]}"; do
    [[ $M1_UP -eq 1 ]] && { R="$(call_model "$M1" "$m")"; [[ -n "$R" ]] && echo "$R" && exit 0; }
  done
  for m in "${MODELS_M2[@]}"; do
    [[ $M2_UP -eq 1 ]] && { R="$(call_model "$M2" "$m")"; [[ -n "$R" ]] && echo "$R" && exit 0; }
  done
  [[ $OL3_UP -eq 1 ]] && { R="$(call_ollama "$M3_OLLAMA" "gemma3:4b" "$OL1_KEEP")"; [[ -n "$R" ]] && echo "$R" && exit 0; }
  [[ $OL1_UP -eq 1 ]] && { R="$(call_ollama "http://127.0.0.1:11434" "$MODEL_OL1" "$OL1_KEEP")"; [[ -n "$R" ]] && echo "$R" && exit 0; }
  echo "✘ Tous backends ont échoué" >&2; exit 2
fi
